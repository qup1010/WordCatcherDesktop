<Window x:Class="WordCatcher.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
        xmlns:views="clr-namespace:WordCatcher.App.Views"
        xmlns:converters="clr-namespace:WordCatcher.App.Converters"
        xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Word Catcher 桌面伴侣"
        Icon="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.ico"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        Background="#F6F8F7"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/WordCatcher.App;component/Themes/DesignSystem.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:SyncStatusLabelConverter x:Key="SyncStatusLabel" />
        <converters:LocalDateTimeConverter x:Key="LocalTime" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBoxStyle}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}" />

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,12" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#0F766E" />
            <Setter Property="Background" Value="#E6EEE9" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="44" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#0F766E" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EAF3EE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F2F4F4" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E9EEEE" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C9D8D6" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0F766E" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox" BasedOn="{StaticResource AppGroupBoxStyle}" />

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="40">
                            <Border x:Name="TabBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F0F2F2" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#E9EEEE" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#E9EEEE" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Divider"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="#E2E8F0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="#5FA99F" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="#0F766E" />
                                <Setter TargetName="Divider" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="#0F766E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="208" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#F8FAF9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ItemsPresenter Grid.Row="0" Margin="0,12,0,0" />

                                    <Border Grid.Row="1"
                                            Background="Transparent"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="0"
                                            Margin="12,12,12,16"
                                            Padding="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="快速取词" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                            <Border Background="{StaticResource SubtleSurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,5,0,0"
                                                    Padding="7,2">
                                                <TextBlock Text="{Binding AppliedHotkey}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CanvasBrush}">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                  Margin="24,20,24,22" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Background="#F2F7F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                           Width="22" Height="22" Stretch="Uniform" />
                    <TextBlock Text="Word Catcher" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Width="42" Height="34" MinHeight="34" Padding="0" Background="Transparent"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                    </Button>
                    <Button x:Name="MaximizeButton" Width="42" Height="34" MinHeight="34" Padding="0" Background="Transparent"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="MaximizeButton_Click" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                    </Button>
                    <Button x:Name="CloseButton" Width="42" Height="34" MinHeight="34" Padding="0" Background="Transparent"
                            Foreground="#A43739" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click" ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1"
                    Style="{StaticResource SidebarTabControl}">

            <!-- ================= TAB 1: 词库 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="LibraryTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="生词库" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="#334155">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="生词库" FontSize="25" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="整理收藏的词条，并回看它们出现时的真实语境"
                                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ExportJsonCommand}"
                                    Margin="0,0,10,0"
                                    Padding="12,6"
                                    Background="#FFFFFF"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    Foreground="#475569"
                                    FontSize="12"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Words.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="导出备份" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding Words.Count, StringFormat={}{0} 个词条}"
                                       Foreground="#64748B"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="#FFFFFF"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                        <Grid x:Name="LibraryWorkspace">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Words.Count}" Value="0" />
                                                <Condition Binding="{Binding SearchQuery}" Value="" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" MinWidth="250" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                        <GridSplitter Grid.Column="1"
                                      Width="9"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Style="{StaticResource WorkspaceSplitterStyle}"
                                      ToolTip="拖动调整列表与详情宽度" />
                        <!-- Left: Search & Word List -->
                        <Border Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Search Bar -->
                                <Grid Grid.Row="0" Margin="0,0,0,10" IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}">
                                    <TextBox x:Name="SearchBox"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="32,6,32,6"
                                             FontSize="12"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             ToolTip="输入即搜索；Ctrl+F 聚焦，Esc 清空搜索"
                                             KeyDown="SearchBox_KeyDown" />
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="13"
                                               Foreground="#64748B"
                                               Margin="11,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <TextBlock Text="搜索单词、释义或语境"
                                               Margin="32,0,32,0"
                                               VerticalAlignment="Center"
                                               Foreground="#94A3B8"
                                               FontSize="12"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Command="{Binding ClearSearchCommand}"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#64748B"
                                            Visibility="{Binding SearchQuery, Converter={StaticResource StringToVis}}"
                                            ToolTip="清空搜索">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="11" />
                                    </Button>
                                </Grid>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <CheckBox Content="紧凑列表" IsChecked="{Binding IsCompact}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" />
                                    <Button Content="加载更多词条" Command="{Binding LoadMoreCommand}" Margin="0,8,0,0" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- Words ListBox -->
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="WordList"
                                             ItemsSource="{Binding Words}"
                                             IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             SelectedItem="{Binding SelectedWord, Mode=TwoWay}"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,8"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding DisplayWord}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="14"
                                                                       Foreground="#0F172A" />
                                                            <TextBlock Text="{Binding Reading}"
                                                                       FontSize="12"
                                                                       Foreground="#64748B"
                                                                       Margin="6,1,0,0" />
                                                            <Border Background="#ECFDF5"
                                                                    CornerRadius="3"
                                                                    Padding="4,1"
                                                                    Margin="6,1,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding PartOfSpeech, Converter={StaticResource StringToVis}}">
                                                                <TextBlock Text="{Binding PartOfSpeech}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#059669" />
                                                            </Border>
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Definition}"
                                                                   FontSize="12"
                                                                   Foreground="#64748B"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="28"
                                                   Foreground="#CBD5E1" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EmptyMessage}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="#64748B" Margin="0,8,0,0" />
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=WordList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right: Word Detail & Occurrences / Edit View -->
                        <Border Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="22">
                            <Grid>
                                <!-- No selection prompt -->
                                            <TextBlock Text="从左侧选择一个词条，查看释义、语境记录或编辑内容"
                                           Foreground="#9CA3AF"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Selected Word View / Edit Area -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Scrollable Main Content -->
                                    <ScrollViewer Grid.Row="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0,0,10,0">
                                        <StackPanel>
                                            <!-- Normal Display Mode -->
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <!-- Header: Word, Reading, POS -->
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedWord.DisplayWord}"
                                                               TextWrapping="Wrap" FontSize="26"
                                                               FontWeight="Bold"
                                                               Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding SelectedWord.Reading}"
                                                               FontSize="15"
                                                               Foreground="#64748B"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <Border Margin="10,0,0,0"
                                                            Background="#ECFDF5"
                                                            CornerRadius="4"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding SelectedWord.PartOfSpeech, Converter={StaticResource StringToVis}}">
                                                        <TextBlock Text="{Binding SelectedWord.PartOfSpeech}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#059669" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Definition Text -->
                                                <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,16,0,14">
                                                    <StackPanel>
                                                        <TextBlock Text="释义" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding DefinitionPreview}" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="#334155" Visibility="{Binding IsDefinitionExpanded, Converter={StaticResource InverseBoolToVis}}" />
                                                        <Expander Header="完整释义" IsExpanded="{Binding IsDefinitionExpanded, Mode=TwoWay}" Margin="0,8,0,0" Foreground="#0F766E">
                                                            <TextBlock Text="{Binding SelectedWord.Definition}" FontSize="14" LineHeight="24" Foreground="#334155" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        </Expander>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Memory Hook (Wrapping supported) -->
                                                <Border Background="#FFFBEB"
                                                        BorderBrush="#FEF3C7"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10"
                                                        Margin="0,0,0,14"
                                                        Visibility="{Binding SelectedWord.MemoryHook, Converter={StaticResource StringToVis}}">
                                                    <TextBlock Foreground="#92400E" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                                                        <Bold>💡 记忆线索: </Bold>
                                                        <Run Text="{Binding SelectedWord.MemoryHook}" />
                                                    </TextBlock>
                                                </Border>

                                                <!-- Occurrence Records Card -->
                                                <Border Background="#F8FAFC"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="14"
                                                        Margin="0,0,0,8">
                                                    <Expander IsExpanded="True">
                                                        <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="语境捕获记录"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#334155" />
                                                        <TextBlock Text="{Binding Occurrences.Count, StringFormat=（{0}）}" Foreground="#64748B" />
                                                        </StackPanel>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,12,0,0">
                                                        <ListBox x:Name="OccurrenceList"
                                                                 ItemsSource="{Binding Occurrences}"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="12,10"
                                                                            Background="#FFFFFF"
                                                                            BorderBrush="#E2E8F0"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Margin="0,0,0,8">
                                                                        <Expander IsExpanded="False">
                                                                            <Expander.Header>
                                                                            <TextBlock Text="{Binding Sentence}"
                                                                                       FontSize="13"
                                                                                       Foreground="#1E293B"
                                                                                        TextTrimming="CharacterEllipsis"
                                                                                       FontWeight="Medium"
                                                                                       LineHeight="20" />
                                                                            </Expander.Header>
                                                                            <StackPanel Margin="0,10,0,0">
                                                                                <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#1E293B" />
                                                                            <TextBlock Text="{Binding ContextTranslation}"
                                                                                       FontSize="12"
                                                                                       Foreground="#64748B"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="0,4,0,0"
                                                                                       LineHeight="18" />
                                                                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                                                                       Foreground="#94A3B8"
                                                                                       Margin="0,6,0,0">
                                                                                <Run Text="来源  " />
                                                                                <Run Text="{Binding SourceProcess}" FontWeight="SemiBold" Foreground="#64748B" />
                                                                                <Run Text=" · " />
                                                                                <Run Text="{Binding SourceWindowTitle}" />
                                                                                <Run Text=" · " />
                                                                                <Run Text="{Binding CapturedAtUtc, Converter={StaticResource LocalTime}}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                        </Expander>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>

                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,16,0,12">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=OccurrenceList, Path=HasItems}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="暂无语境记录"
                                                                       FontWeight="Medium"
                                                                       FontSize="13"
                                                                       Foreground="#94A3B8"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="屏幕取词时会自动捕获并记录原句与来源"
                                                                       FontSize="11"
                                                                       Foreground="#CBD5E1"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    </Expander>
                                                </Border>
                                            </StackPanel>

                                            <!-- Edit Mode Form -->
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="编辑词条" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />

                                                <TextBlock Text="单词 / 原形:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditWordText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />

                                                <TextBlock Text="音标:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditReading, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />

                                                <TextBlock Text="词性:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditPartOfSpeech, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,10" />

                                                <TextBlock Text="释义:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}"
                                                         Padding="8,6"
                                                         Height="100"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Margin="0,0,0,10" />

                                                <TextBlock Text="记忆线索:" FontSize="12" Foreground="#64748B" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding EditMemoryHook, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,14" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Bottom Action Buttons -->
                                    <Border Grid.Row="1"
                                            BorderBrush="#F1F5F9"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0"
                                            Margin="0,8,0,0">
                                        <Grid>
                                            <!-- Normal Mode Actions -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <Button Content="编辑"
                                                        Command="{Binding StartEditCommand}"
                                                        Padding="14,6"
                                                        Margin="0,0,8,0"
                                                        Background="#F1F5F9"
                                                        Foreground="#334155"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                                <Button Content="删除词条"
                                                        Command="{Binding DeleteWordCommand}"
                                                        Padding="14,6"
                                                        Background="#FEE2E2"
                                                        Foreground="#B91C1C"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                            </StackPanel>

                                            <!-- Edit Mode Actions -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <Button Content="保存修改"
                                                        Command="{Binding SaveEditCommand}"
                                                        Padding="14,6"
                                                        Background="#0F766E"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand" />
                                                <Button Content="取消"
                                                        Command="{Binding CancelEditCommand}"
                                                        Padding="14,6"
                                                        Background="#F1F5F9"
                                                        Foreground="#475569"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <Border x:Name="EmptyLibraryWorkspace"
                                Background="#FFFFFF">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Words.Count}" Value="0" />
                                                <Condition Binding="{Binding SearchQuery}" Value="" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                                       Width="52"
                                       Height="52" />
                                <TextBlock Text="还没有收藏的词条"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="新的收藏会显示在这里"
                                           FontSize="12"
                                           Foreground="#94A3B8"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: 查单词 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="LookupTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="查单词" />
                    </StackPanel>
                </TabItem.Header>
                <views:WordLookupView x:Name="LookupPage" />
            </TabItem>

            <!-- ================= TAB 3: 待同步 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="SyncTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="Anki 同步" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="#334155">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Anki 同步" FontSize="25" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="收藏先保存在本地，Anki 在后台同步"
                                       FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                                Background="White" BorderBrush="#DCE5E4" BorderThickness="1"
                                ToolTip="刷新同步状态" AutomationProperties.Name="刷新同步状态">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Border Background="White" BorderBrush="#DCE5E4" BorderThickness="1" CornerRadius="7" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="6"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F3EF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PageState}" Value="{x:Static vm:SyncPageState.Disabled}">
                                                        <Setter Property="Background" Value="#EDF0F0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PageState}" Value="{x:Static vm:SyncPageState.Attention}">
                                                        <Setter Property="Background" Value="#FFF2E7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PageState}" Value="{x:Static vm:SyncPageState.Empty}">
                                                        <Setter Property="Background" Value="#EDF0F0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateGlyph}" FontFamily="Segoe Fluent Icons"
                                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#0F766E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PageState}" Value="{x:Static vm:SyncPageState.Attention}">
                                                            <Setter Property="Foreground" Value="#A65D2B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PageState}" Value="{x:Static vm:SyncPageState.Disabled}">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PageState}" Value="{x:Static vm:SyncPageState.Empty}">
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,20,0">
                                        <TextBlock Text="{Binding StateTitle}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="#172329" />
                                        <TextBlock Text="{Binding StateDescription}" FontSize="12" Foreground="#566976"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button x:Name="OpenAnkiSettingsButton" Grid.Column="2" Content="打开设置" Click="OpenAnkiSettings_Click"
                                            VerticalAlignment="Center" Background="#0F766E" Foreground="White"
                                            Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}" />
                                    <Button Grid.Column="2" Content="重试同步" Command="{Binding RetryAllCommand}"
                                            VerticalAlignment="Center" Background="#0F766E" Foreground="White"
                                            Visibility="{Binding HasActionableIssues, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>

                            <Grid Margin="2,20,2,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="已同步" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding SyncedCount}" FontSize="22" FontWeight="SemiBold" Foreground="#172329" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="等待中" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding WaitingCount}" FontSize="22" FontWeight="SemiBold" Foreground="#172329" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="需处理" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding IssueCount}" FontSize="22" FontWeight="SemiBold" Foreground="#172329" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,24,0,0" Visibility="{Binding HasActionableIssues, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="需要处理的同步项" FontSize="14" FontWeight="SemiBold" Foreground="#172329" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding IssueJobs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DCE5E4" BorderThickness="0,0,0,1" Padding="0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,16,0">
                                                        <TextBlock Text="{Binding Word.DisplayWord, TargetNullValue=未知单词}" FontSize="13" FontWeight="SemiBold" Foreground="#172329" />
                                                        <TextBlock Text="{Binding LastError}" FontSize="12" Foreground="#6A7780" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource SyncStatusLabel}}"
                                                               FontSize="12" Foreground="#9A4E2F" VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MoreIssuesCount, StringFormat=另有 {0} 项未显示；重试同步仍会处理全部}"
                                           FontSize="12" Foreground="#7C8D98" Margin="0,10,0,0"
                                           Visibility="{Binding HasMoreIssues, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <Expander x:Name="SyncHistoryExpander" Header="查看最近的同步记录" Margin="0,24,0,0"
                                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding RecentJobs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="105" />
                                                        <ColumnDefinition Width="125" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Word.DisplayWord, TargetNullValue=未知单词}" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource SyncStatusLabel}}" FontSize="12" Foreground="#566976" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UpdatedAtUtc, Converter={StaticResource LocalTime}}" FontSize="12" Foreground="#7C8D98" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>

                            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,20,0,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#7C8D98" Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: 设置 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="SettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="设置" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="#334155">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="设置" FontSize="25" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="管理取词、离线词典、翻译服务和 Anki 集成"
                                   FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                    </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="0,0,12,0">
                        <!-- 1. 全局快捷键 -->
                        <GroupBox Header="取词快捷键" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Foreground="#64748B" FontSize="12" Margin="0,0,0,12">
                                    <Run Text="当前生效：" /><Run Text="{Binding AppliedHotkey, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <WrapPanel>
                                    <Border Background="#EAF3EE" BorderBrush="#CFE3D5" BorderThickness="1" CornerRadius="8" Padding="16,9" MinWidth="140" Margin="0,0,8,8">
                                        <TextBlock Text="{Binding Hotkey}" Foreground="#115E59" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </Border>
                                    <Button x:Name="RecordHotkeyButton" Command="{Binding RecordHotkeyCommand}" Margin="0,0,8,8" MinHeight="40" Background="#0F766E" Foreground="White" ToolTip="点击后直接按组合键，无需输入名称">
                                        <TextBlock>
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="录入快捷键" /><Style.Triggers><DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True"><Setter Property="Text" Value="等待按键…" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                    <Button Content="取消录入" Command="{Binding CancelHotkeyRecordingCommand}" Margin="0,0,8,8" MinHeight="40" Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="恢复默认" Command="{Binding ResetHotkeyCommand}" Margin="0,0,0,8" MinHeight="40" ToolTip="填入 Alt+Q，保存后生效" />
                                </WrapPanel>
                                <TextBlock Text="{Binding HotkeyHint}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" LineHeight="19" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 2. Open Dictionary 离线词典 -->
                        <GroupBox Header="Open Dictionary 离线词典" Padding="14" Margin="0,0,0,16" BorderBrush="#E5E7EB">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="安装状态: " FontWeight="Medium" />
                                    <TextBlock Text="{Binding DictStatusText}" FontWeight="Bold" Foreground="#0F766E" />
                                </StackPanel>
                                <TextBlock Text="{Binding DictDetailsText}" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,0,0,10" />

                                <TextBlock Text="官方下载源 URL:" Foreground="#6B7280" Margin="0,0,0,3" />
                                <TextBox Text="{Binding DictDownloadUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" Margin="0,0,0,10" />

                                <!-- Progress indicator during install -->
                                <StackPanel Visibility="{Binding IsDictInstalling, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <ProgressBar Value="{Binding DictProgressValue}" Height="6" Maximum="100" Foreground="#0F766E" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding DictProgressText}" FontSize="12" Foreground="#6B7280" />
                                </StackPanel>

                                <WrapPanel>
                                    <Button Content="在线下载并安装"
                                            Command="{Binding InstallDictFromUrlCommand}"
                                            IsEnabled="{Binding IsDictInstalling, Converter={StaticResource InverseBool}}"
                                            Padding="12,6"
                                            Background="#0F766E"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,8,0"
                                            Cursor="Hand" />
                                    <Button Content="从本地工件安装 (.sqlite.gz)"
                                            Command="{Binding InstallDictFromFileCommand}"
                                            IsEnabled="{Binding IsDictInstalling, Converter={StaticResource InverseBool}}"
                                            Padding="12,6"
                                            Background="#F3F4F6"
                                            Foreground="#374151"
                                            BorderThickness="0"
                                            Margin="0,0,8,0"
                                            Cursor="Hand" />
                                    <Button Content="删除离线词典" IsEnabled="{Binding IsDictInstalling, Converter={StaticResource InverseBool}}"
                                            Command="{Binding RemoveDictCommand}"
                                            Padding="12,6"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderThickness="0"
                                            Cursor="Hand" />
                                </WrapPanel>

                                <!-- Attribution notice (CC BY-SA 4.0) -->
                                <Border Background="#F9FAFB" CornerRadius="6" Padding="10" Margin="0,14,0,0">
                                    <TextBlock FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" LineHeight="16">
                                        <Bold>数据署名与许可声明：</Bold><LineBreak />
                                        离线词典基于 <Run Text="ahpxex/open-dictionary" FontWeight="SemiBold" /> 项目发行工件，数据源自 English Wiktionary 及贡献者与 Wiktextract 项目，遵循 CC BY-SA 4.0 知识共享许可协议。本桌面应用代码与词典数据独立授权。
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- 3. 翻译服务 -->
                        <GroupBox Header="翻译服务" Padding="14" Margin="0,0,0,16" BorderBrush="#E5E7EB">
                            <StackPanel>
                                <TextBlock Text="离线词典未命中或选中长句时，优先使用免费机翻；点击卡片里的「AI 详解」时使用当前 AI 配置。"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AI 配置:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox Width="220"
                                                  ItemsSource="{Binding AiProfiles}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding ActiveAiProfileId, UpdateSourceTrigger=PropertyChanged}"
                                                  Padding="6,3" />
                                        <Button Content="新增"
                                                Command="{Binding AddAiProfileCommand}"
                                                Margin="8,0,0,0"
                                                Padding="10,4"
                                                Background="#F3F4F6"
                                                BorderThickness="0" />
                                        <Button Content="删除"
                                                Command="{Binding RemoveAiProfileCommand}"
                                                Margin="6,0,0,0"
                                                Padding="10,4"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderThickness="0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="配置名称:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AiProfileName, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,4" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Base URL:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模型名称:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="未命中时的快速翻译:" VerticalAlignment="Center" TextWrapping="Wrap" LineHeight="18" Foreground="#64748B" Margin="0,0,10,0" />
                                    <ComboBox Grid.Column="1"
                                              SelectedValue="{Binding MachineTranslationProvider, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Tag"
                                              Padding="6,3">
                                        <ComboBoxItem Content="微软翻译（默认）" Tag="microsoft" />
                                        <ComboBoxItem Content="谷歌翻译" Tag="google" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API Key:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" PasswordChanged="ApiKeyBox_PasswordChanged" Padding="8,6" MinHeight="36" VerticalContentAlignment="Center" ToolTip="密钥仅用于当前 AI 配置，本地加密保存" AutomationProperties.Name="API Key" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="释义语言:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding ExplainLanguage, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </Grid>

                                <Button Content="测试连通性"
                                        Command="{Binding TestAiConnectionCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="12,5"
                                        Background="#F3F4F6"
                                        Foreground="#374151"
                                        BorderThickness="0"
                                        Margin="132,4,0,0"
                                        Cursor="Hand" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 4. Anki 同步 -->
                        <GroupBox x:Name="AnkiSettingsGroup" Header="Anki 配置" Padding="14" Margin="0,0,0,16" BorderBrush="#E5E7EB">
                            <StackPanel>
                                <CheckBox Content="启用 Anki 后台同步" IsChecked="{Binding AnkiEnabled}" Margin="0,0,0,10" FontWeight="Medium" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AnkiConnect URL:" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding AnkiUrl, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="牌组名称 (Deck):" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding AnkiDeckName, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="笔记类型 (Model):" VerticalAlignment="Center" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding AnkiNoteTypeName, UpdateSourceTrigger=PropertyChanged}" Padding="8,4" />
                                </Grid>

                                <CheckBox Content="在例句中自动生成填空挖空 ([ ? ])" IsChecked="{Binding AnkiClozeContext}" Margin="132,4,0,8" />

                                <Button Content="测试 Anki 连接"
                                        Command="{Binding TestAnkiConnectionCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="12,5"
                                        Background="#F3F4F6"
                                        Foreground="#374151"
                                        BorderThickness="0"
                                        Margin="132,4,0,0"
                                        Cursor="Hand" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 5. 交互行为 -->
                        <GroupBox Header="交互行为" Padding="14" Margin="0,0,0,20" BorderBrush="#E5E7EB">
                            <CheckBox Content="查词弹窗点击「保存」后自动关闭浮窗" IsChecked="{Binding ClosePopupAfterSave}" />
                        </GroupBox>

                        <!-- 6. 关于与更新 -->
                        <GroupBox Header="关于与更新" Padding="14" Margin="0,0,0,20" BorderBrush="#E5E7EB">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Word Catcher" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="当前版本 " Foreground="#64748B" FontSize="12" />
                                            <TextBlock Text="{Binding AppVersion}" Foreground="#334155" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="检查更新"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                            Background="#0F766E"
                                            Foreground="White"
                                            Padding="14,7"
                                            ToolTip="检查 GitHub Releases 中是否有新版本" />
                                </Grid>
                                <TextBlock Text="Word Catcher 是一款本地优先的桌面取词与词库工具，支持离线词典、语境记录和 Anki 同步。"
                                           TextWrapping="Wrap"
                                           Foreground="#475569"
                                           FontSize="12"
                                           LineHeight="19"
                                           Margin="0,0,0,10" />
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="#334155" FontSize="12" />
                                        <TextBlock Text="更新检查只访问 GitHub Release 信息，不会上传词库、API Key 或取词内容。"
                                                   TextWrapping="Wrap"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <Button Content="打开项目主页"
                                            Command="{Binding OpenProjectPageCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"
                                            Background="#F1F5F9"
                                            Foreground="#334155"
                                            ToolTip="在浏览器中打开项目主页" />
                                    <Button Content="打开下载页面"
                                            Command="{Binding OpenLatestReleasePageCommand}"
                                            Padding="12,6"
                                            Background="#F1F5F9"
                                            Foreground="#334155"
                                            ToolTip="在浏览器中打开最新 GitHub Release" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="14,12" Margin="0,10,0,0" CornerRadius="8">
                <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxHeight="66" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Foreground="#475569" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button Grid.Column="1" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" Background="#0F766E" Foreground="White" Padding="18,9">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="保存所有设置" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Text" Value="正在保存…" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
