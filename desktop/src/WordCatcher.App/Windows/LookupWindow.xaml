<Window x:Class="WordCatcher.App.Windows.LookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
        xmlns:converters="clr-namespace:WordCatcher.App.Converters"
        xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LookupViewModel}"
        Title="Word Catcher"
        Width="460"
        MinWidth="460"
        MaxWidth="460"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />

        <Style x:Key="PopupButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource PopupButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PinButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PinBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PinBorder" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PinBorder" Property="Background" Value="#4F46E5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,0,0,0">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="#CBD5E1">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="#FFFFFF"
            CornerRadius="16"
            BorderBrush="#E2E8F0"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Opacity="0.20"
                              ShadowDepth="6"
                              Color="#0F172A" />
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,14"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Word}"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="325" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock Text="{Binding Reading}"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Reading, Converter={StaticResource StringToVis}}" />
                        <Border Margin="8,0,0,0"
                                Background="#ECFDF5"
                                CornerRadius="5"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Visibility="{Binding PartOfSpeech, Converter={StaticResource StringToVis}}">
                            <TextBlock Text="{Binding PartOfSpeech}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#047857" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border CornerRadius="7"
                            Padding="8,4"
                            Margin="0,1,8,0"
                            Background="#EEF2FF"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4F46E5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="词典" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.OpenDictionary}">
                                            <Setter Property="Text" Value="离线词典" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.MachineTranslation}">
                                            <Setter Property="Text" Value="快速翻译" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.Ai}">
                                            <Setter Property="Text" Value="AI 详解" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <ToggleButton x:Name="PinToggle"
                                  Style="{StaticResource PinButton}"
                                  Margin="0,0,6,0"
                                  ToolTip="钉住卡片；保持位置并在这里刷新后续取词"
                                  Checked="PinToggle_Checked"
                                  Unchecked="PinToggle_Unchecked">
                        <Path Width="14" Height="14"
                              Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="M7,2 L17,2 L17,4 L15,6 L15,12 L18,15 L18,17 L13,17 L13,22 L11,22 L11,17 L6,17 L6,15 L9,12 L9,6 L7,4 Z" />
                    </ToggleButton>
                    <Button
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="关闭 (Esc)">
                        <Path Width="12" Height="12"
                              Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M2,2 L10,10 M10,2 L2,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Loading / error / result -->
            <Grid Grid.Row="1">
                <StackPanel Margin="0,22"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Foreground="#6366F1"
                                 Background="#E2E8F0" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="0,4,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Border Background="#FEF2F2" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="暂时无法完成查询"
                                       FontWeight="SemiBold"
                                       Foreground="#991B1B"
                                       Margin="0,0,0,5" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#B91C1C"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Button Content="重新查询"
                            Command="{Binding RetryCommand}"
                            Style="{StaticResource PopupButton}"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0" />
                </StackPanel>

                <ScrollViewer MaxHeight="430"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,5,0">
                        <!-- AI / machine translation uses the flattened definition.
                             Dictionary results render structured senses below to avoid duplication. -->
                        <TextBlock Text="{Binding Definition}"
                                   FontSize="15"
                                   LineHeight="24"
                                   Foreground="#1E293B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.OpenDictionary}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding DisplayPosGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                <TextBlock Text="{Binding Pos}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#4F46E5" />
                                                <TextBlock Text="{Binding Summary}"
                                                           FontSize="12"
                                                           Foreground="#64748B"
                                                           Margin="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Meanings}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="16" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="•" Foreground="#94A3B8" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding LearnerExplanation}"
                                                                           FontSize="13"
                                                                           LineHeight="20"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="#1E293B"
                                                                           Visibility="{Binding LearnerExplanation, Converter={StaticResource StringToVis}}" />
                                                                <TextBlock Text="{Binding ShortGloss}"
                                                                           FontSize="12"
                                                                           Foreground="#64748B"
                                                                           Margin="0,2,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding ShortGloss, Converter={StaticResource StringToVis}}" />
                                                                <Border Background="#FFF7ED"
                                                                        CornerRadius="6"
                                                                        Padding="8,5"
                                                                        Margin="0,5,0,0"
                                                                        Visibility="{Binding UsageNote, Converter={StaticResource StringToVis}}">
                                                                    <TextBlock Text="{Binding UsageNote}"
                                                                               FontSize="12"
                                                                               Foreground="#9A3412"
                                                                               TextWrapping="Wrap" />
                                                                </Border>
                                                                <ItemsControl ItemsSource="{Binding Examples}" Margin="0,5,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Margin="0,0,0,5">
                                                                                <TextBlock Text="{Binding Text}"
                                                                                           FontSize="12"
                                                                                           FontStyle="Italic"
                                                                                           Foreground="#475569"
                                                                                           TextWrapping="Wrap" />
                                                                                <TextBlock Text="{Binding Translation}"
                                                                                           FontSize="11"
                                                                                           Foreground="#94A3B8"
                                                                                           TextWrapping="Wrap"
                                                                                           Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding DetailsToggleText}"
                                Command="{Binding ToggleDetailsCommand}"
                                Style="{StaticResource PopupButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"
                                Padding="10,7"
                                Visibility="{Binding CanExpandDetails, Converter={StaticResource BoolToVis}}" />

                        <Border Background="#F1F5F9"
                                CornerRadius="9"
                                Padding="12,9"
                                Margin="0,0,0,9"
                                Visibility="{Binding ContextTranslation, Converter={StaticResource StringToVis}}">
                            <StackPanel>
                                <TextBlock Text="语境翻译" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" />
                                <TextBlock Text="{Binding ContextTranslation}"
                                           FontSize="13"
                                           Foreground="#334155"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFBEB"
                                CornerRadius="9"
                                Padding="12,9"
                                Visibility="{Binding MemoryHook, Converter={StaticResource StringToVis}}">
                            <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap">
                                <Run Text="记忆线索  " FontWeight="SemiBold" />
                                <Run Text="{Binding MemoryHook}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="2"
                  Margin="0,14,0,0"
                  Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SpeakCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="朗读原句">
                        <Path Width="15" Height="15"
                              Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M3,9 L7,9 L12,4 L12,20 L7,15 L3,15 Z M15,8 C17,10 17,14 15,16 L16.5,17.5 C19.5,14.5 19.5,9.5 16.5,6.5 Z" />
                    </Button>
                    <TextBlock Text="{Binding SavedStatusText}"
                               FontSize="11"
                               Foreground="#64748B"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="125"
                               ToolTip="{Binding SavedStatusText}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="AI 详解"
                            Command="{Binding ForceAiCommand}"
                            Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PopupButton}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.Ai}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="复制"
                            Command="{Binding CopyResultCommand}"
                            Style="{StaticResource PopupButton}"
                            Margin="0,0,8,0"
                            ToolTip="复制单词与释义 (Ctrl+C)" />
                    <Button Content="保存"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource PopupButton}"
                            Background="#4F46E5"
                            Foreground="#FFFFFF"
                            Padding="18,8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
