<Window x:Class="WordCatcher.App.Windows.LookupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:WordCatcher.App.Controls"
        xmlns:converters="clr-namespace:WordCatcher.App.Converters"
        xmlns:themes="clr-namespace:WordCatcher.App.Themes"
        xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LookupViewModel}"
        Title="Word Catcher"
        Icon="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.ico"
        Width="420"
        MinWidth="280"
        MaxWidth="460"
        SizeToContent="Height"
        MaxHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource UiFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <themes:StandaloneDesignSystemDictionary />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="PopupButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryActionButton}" />

        <Style x:Key="HeaderIconAction" TargetType="{x:Type ButtonBase}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border x:Name="HeaderActionSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HeaderActionSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderActionSurface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="IconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource HeaderIconAction}" />
        <Style x:Key="CloseIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopupToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource HeaderIconAction}">
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Minimal translation-only card (inspired by Sotto minimal overlay) -->
        <Grid x:Name="MinimalCardContainer"
              Visibility="{Binding IsMinimalMode, Converter={StaticResource BoolToVis}}"
              Cursor="Hand"
              MouseLeftButtonDown="MinimalCard_MouseLeftButtonDown"
              MouseRightButtonUp="MinimalCard_MouseRightButtonUp"
              ToolTip="左键拖动 · 右键关闭 · Tab 展开完整卡片">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect BlurRadius="14" Opacity="0.14" ShadowDepth="3" Color="#000000" /></Border.Effect>
            </Border>
            <Border Style="{StaticResource SurfaceCardStyle}" CornerRadius="10" Padding="13,9" RenderOptions.ClearTypeHint="Enabled">
                <StackPanel>
                    <StackPanel x:Name="MinimalLoadingPanel" Width="184" Margin="0,2,0,1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <Border Height="10" HorizontalAlignment="Stretch" CornerRadius="4" Background="{DynamicResource SubtleSurfaceBrush}" Margin="0,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="88" Height="10" CornerRadius="4" Background="{DynamicResource SubtleSurfaceBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="正在翻译…" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <ScrollViewer x:Name="MinimalScroll" MaxHeight="146" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock x:Name="MinimalTranslationText"
                                   Text="{Binding MinimalDisplayText}"
                                   FontSize="14.5"
                                   LineHeight="22"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>
                    <TextBlock Text="{Binding ActionStatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" Visibility="{Binding ActionStatusText, Converter={StaticResource StringToVis}}" />
                    <TextBlock Text="{Binding SavedStatusText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" Visibility="{Binding SavedStatusText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Standard & mini card -->
        <Grid x:Name="StandardCardContainer"
              Visibility="{Binding IsStandardCard, Converter={StaticResource BoolToVis}}"
              MouseRightButtonUp="StandardCard_MouseRightButtonUp">
        <!-- Keep the shadow off the text subtree so its intermediate bitmap cannot soften glyphs. -->
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="20" Opacity="0.18" ShadowDepth="4" Color="#1E293B" /></Border.Effect>
        </Border>
        <Border Style="{StaticResource SurfaceCardStyle}" CornerRadius="16" RenderOptions.ClearTypeHint="Enabled">
        <Grid Margin="14,11">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="CardHeader" Margin="0,0,0,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="HeaderDragHandle" Grid.Row="0" Width="72" Height="18"
                        Background="Transparent" Cursor="SizeAll" HorizontalAlignment="Center"
                        ToolTip="拖动此处移动卡片"
                        MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                    <Border Width="40" Height="4" CornerRadius="2" Background="{DynamicResource TextMutedBrush}" Opacity="0.45"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Grid x:Name="CardHeaderContent" Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="HeaderDragArea" Background="Transparent" Cursor="SizeAll"
                        Margin="0,0,8,0"
                        MouseLeftButtonDown="DragSurface_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" ToolTip="{Binding Word}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource HeadwordFontFamily}" /><Setter Property="FontSize" Value="22" /><Setter Property="LineHeight" Value="28" /><Setter Property="Text" Value="{Binding Word}" /><Style.Triggers><DataTrigger Binding="{Binding IsMiniMode}" Value="True"><Setter Property="FontSize" Value="19" /><Setter Property="LineHeight" Value="24" /></DataTrigger><DataTrigger Binding="{Binding IsMediumHeadword}" Value="True"><Setter Property="FontSize" Value="17" /><Setter Property="LineHeight" Value="22" /></DataTrigger><DataTrigger Binding="{Binding IsExtraLongHeadword}" Value="True"><Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="20" /></DataTrigger><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" /><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="22" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Text" Value="句子翻译" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBox Text="{Binding Reading, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontFamily="{StaticResource PhoneticFontFamily}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" Visibility="{Binding Reading, Converter={StaticResource StringToVis}}" />
                        <WrapPanel Margin="0,5,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Visibility="{Binding IsFullCard, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="离线词典" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.MachineTranslation}"><Setter Property="Text" Value="在线快译" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.Ai}"><Setter Property="Text" Value="AI 详解" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border x:Name="EncounterBadge" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center" Visibility="{Binding EncounterBadgeText, Converter={StaticResource StringToVis}}">
                                <TextBlock Text="{Binding EncounterBadgeText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button x:Name="SpeakButton" Command="{Binding SpeakCommand}" Style="{StaticResource IconButton}" ToolTip="朗读" AutomationProperties.Name="朗读" Visibility="{Binding IsFullCard, Converter={StaticResource BoolToVis}}">
                        <controls:CrispSymbolIcon Symbol="Speaker220" FontSize="16" />
                    </ui:Button>
                    <ui:Button x:Name="OpenInMainButton" Command="{Binding OpenInMainCommand}" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="在主窗口中打开" AutomationProperties.Name="在主窗口中打开" IsEnabled="{Binding HasResult}" Visibility="{Binding IsFullCard, Converter={StaticResource BoolToVis}}">
                        <controls:CrispSymbolIcon Symbol="Open20" FontSize="15" />
                    </ui:Button>
                    <ToggleButton x:Name="PinToggle" AutomationProperties.Name="固定查词浮窗" Style="{StaticResource PinToggleButton}" ToolTip="固定卡片（Ctrl+P）" Checked="PinToggle_Checked" Unchecked="PinToggle_Unchecked">
                        <controls:CrispSymbolIcon Symbol="Pin20" FontSize="15" />
                    </ToggleButton>
                    <ui:Button Command="{Binding CloseCommand}" Style="{StaticResource CloseIconButton}" ToolTip="关闭（Esc）" AutomationProperties.Name="关闭查词浮窗">
                        <controls:CrispSymbolIcon Symbol="Dismiss20" FontSize="15" />
                    </ui:Button>
                </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel x:Name="LoadingSkeletonPanel" Margin="0,6,0,10" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <Border Height="12" HorizontalAlignment="Stretch" CornerRadius="4" Background="{DynamicResource SubtleSurfaceBrush}" Margin="0,0,28,8" />
                    <Border Height="12" HorizontalAlignment="Stretch" CornerRadius="4" Background="{DynamicResource SubtleSurfaceBrush}" Margin="0,0,92,10" />
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <StackPanel x:Name="LookupErrorPanel" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <TextBlock Text="查询未完成" FontWeight="Medium" Foreground="{DynamicResource DangerBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <WrapPanel><ui:Button Content="重新查询" Command="{Binding RetryCommand}" Style="{StaticResource PopupButton}" HorizontalAlignment="Left" Margin="0,8,8,0" />
                    <ui:Button Content="改用在线快译" Command="{Binding QuickFallbackCommand}" Visibility="{Binding CanUseQuickFallback, Converter={StaticResource BoolToVis}}" Style="{StaticResource QuietActionButton}" HorizontalAlignment="Left" Margin="0,8,8,0" />
                    <ui:Button Content="改用 AI 详解" Command="{Binding ForceAiCommand}"
                               Visibility="{Binding CanUseAiFallback, Converter={StaticResource BoolToVis}}"
                               Style="{StaticResource QuietActionButton}" HorizontalAlignment="Left" Margin="0,8,8,0" />
                </WrapPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" x:Name="ResultScroll" MaxHeight="390" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Mini Word Card Body -->
                        <StackPanel x:Name="MiniWordBody" Visibility="{Binding IsCompactWordCard, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding Definition, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" MaxHeight="66" Margin="0,0,0,4" Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding MiniPosGroups}" Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Top" Margin="0,1,6,0">
                                                <TextBlock Text="{Binding DisplayPos, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" FontStyle="Italic" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding QuickSummary, Mode=OneWay}" FontSize="{StaticResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Compact Sentence Bar Body -->
                        <StackPanel x:Name="CompactSentenceBody" Visibility="{Binding IsCompactSentenceCard, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="原文" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding SelectedText, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" MaxHeight="66" Margin="0,0,0,8" />
                            <TextBlock Text="译文" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding Definition, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        </StackPanel>

                        <!-- Full Card Body -->
                        <StackPanel x:Name="FullCardBody" Visibility="{Binding IsFullCard, Converter={StaticResource BoolToVis}}">
                        <StackPanel Visibility="{Binding IsLongText, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                            <TextBlock Text="原文" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedText, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="译文" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
                        </StackPanel>
                        <TextBox Text="{Binding Definition, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource InverseBoolToVis}}" />
                        <ui:TextBox Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding IsEditingDefinition, Converter={StaticResource BoolToVis}}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    MinHeight="54"
                                    Margin="0,0,0,8"
                                    ToolTip="保存前可直接修改释义内容" />
                        <!-- One compact row for EVERY part of speech, never a global Take(3). -->
                        <ItemsControl ItemsSource="{Binding DisplayPosGroups}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Top" Margin="0,1,8,0">
                                            <TextBlock Text="{Binding DisplayPos, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" FontStyle="Italic" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBox Grid.Column="1" Text="{Binding QuickSummary, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:Button Content="{Binding DetailsToggleText}" Command="{Binding ToggleDetailsCommand}" Style="{StaticResource PopupButton}" HorizontalContentAlignment="Left" Padding="10,7" Margin="0,2,0,8" Visibility="{Binding CanExpandDetails, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding DisplayPosGroups}" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,6">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" Margin="0,0,0,8" TextWrapping="Wrap"><Run Text="{Binding DisplayPos, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /><Run Text="  " /><Run Text="{Binding Summary}" /></TextBlock>
                                        <ItemsControl ItemsSource="{Binding Meanings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="6" Padding="10,9" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding DisplayHeading, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,1,0,0" />
                                                            </Grid>
                                                            <StackPanel Margin="0,8,0,0">
                                                                <TextBox Text="{Binding DetailExplanation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="{Binding DetailExplanation, Converter={StaticResource StringToVis}}" />
                                                                <ItemsControl ItemsSource="{Binding FirstExamples}" Margin="0,7,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,0,0,6">
                                                                                <StackPanel>
                                                                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                    <TextBox Text="{Binding Translation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Expander Header="{Binding AdditionalExamplesLabel}" Visibility="{Binding HasAdditionalExamples, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                    <ItemsControl ItemsSource="{Binding AdditionalExamples}" Margin="0,6,0,0">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2,0,0,0" Padding="8,2" Margin="0,0,0,6">
                                                                                    <StackPanel>
                                                                                        <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                        <TextBox Text="{Binding Translation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                                <StackPanel TextElement.FontSize="{StaticResource CaptionFontSize}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding UsageNote, Converter={StaticResource StringToVis}}">
                                                                    <TextBlock Text="用法提示" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,2" />
                                                                    <TextBox Text="{Binding UsageNote, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LearningExpression}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" Visibility="{Binding ShowLearningExpression, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,4,0,12" Visibility="{Binding OriginalSentence, Converter={StaticResource StringToVis}}">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="原句" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                <WrapPanel HorizontalAlignment="Right">
                                    <ui:Button Content="{Binding TranslateSentenceButtonText}"
                                               Command="{Binding TranslateSentenceCommand}"
                                               Visibility="{Binding CanTranslateSentence, Converter={StaticResource BoolToVis}}"
                                               IsEnabled="{Binding IsTranslatingSentence, Converter={StaticResource InverseBool}}"
                                               Style="{StaticResource QuietActionButton}"
                                               Padding="6,2" MinHeight="24" FontSize="{StaticResource CaptionFontSize}" />
                                    <ui:Button Content="改用 AI" Command="{Binding UseAiSentenceTranslationCommand}"
                                               Visibility="{Binding CanUseAiSentenceTranslation, Converter={StaticResource BoolToVis}}"
                                               IsEnabled="{Binding IsTranslatingSentence, Converter={StaticResource InverseBool}}"
                                               Style="{StaticResource QuietActionButton}"
                                               Padding="6,2" MinHeight="24" Margin="4,0,0,0" FontSize="{StaticResource CaptionFontSize}" />
                                </WrapPanel>
                            </Grid>
                            <TextBox Text="{Binding OriginalSentence, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SentenceTranslationError}" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource CaptionFontSize}"
                                       TextWrapping="Wrap" Margin="0,5,0,0"
                                       Visibility="{Binding SentenceTranslationError, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,10" Visibility="{Binding ShowOcrWordPicker, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="点选句中词条查词（保留原句）" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
                            <ItemsControl x:Name="OcrTokenList" ItemsSource="{Binding OcrSentenceTokens}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button Content="{Binding Text}"
                                                   Command="{Binding DataContext.SelectOcrTokenCommand, ElementName=OcrTokenList}"
                                                   CommandParameter="{Binding}"
                                                   Style="{StaticResource QuietActionButton}"
                                                   Padding="8,3" MinHeight="26" Margin="0,0,6,6"
                                                   FontSize="{StaticResource CaptionFontSize}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Expander Header="解析与例句" Margin="0,4,0,10" Visibility="{Binding HasLearningDetails, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Visibility="{Binding Analysis.KeyExplanation, Converter={StaticResource StringToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="语境解析" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding Analysis.KeyExplanation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding Analysis.UsageNote, Converter={StaticResource StringToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="用法提示" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding Analysis.UsageNote, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding Analysis.Example, Converter={StaticResource StringToVis}}">
                                    <TextBlock Text="拓展例句" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding Analysis.Example, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBox Text="{Binding Analysis.ExampleTranslation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding Analysis.ExampleTranslation, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                        <Expander Header="编辑与笔记" Margin="0,4,0,10" IsEnabled="{Binding CanSave}" Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="释义" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ui:TextBox Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                <TextBlock Text="原句翻译" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ui:TextBox Text="{Binding EditTranslation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                <TextBlock Text="个人笔记" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ui:TextBox Text="{Binding LearningNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,0" />
                            </StackPanel>
                        </Expander>
                        <Border Style="{StaticResource ReadingTonalBoxStyle}" Margin="0,0,0,10" Visibility="{Binding ContextTranslation, Converter={StaticResource StringToVis}}">
                            <StackPanel>
                                <TextBlock Text="语境翻译" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding ContextTranslation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MemoryHookCardStyle}" Margin="0,2,0,12" Visibility="{Binding MemoryHook, Converter={StaticResource StringToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                <TextBlock Text="记忆线索" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AmberHookLabelBrush}" VerticalAlignment="Center" />
                                <ToggleButton IsChecked="{Binding IsMemoryHookExpanded}" Style="{StaticResource CompactPillToggleStyle}" Foreground="{DynamicResource AmberHookLabelBrush}" HorizontalAlignment="Right" FontSize="{StaticResource CaptionFontSize}" AutomationProperties.Name="展开或收起记忆线索">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"><Setter Property="Text" Value="展开" /><Style.Triggers><DataTrigger Binding="{Binding IsMemoryHookExpanded}" Value="True"><Setter Property="Text" Value="收起" /></DataTrigger></Style.Triggers></Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                </Grid>
                                <TextBox Text="{Binding MemoryHook, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource AmberHookTextBrush}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource SelectableTextBlockBox}">
                                            <Setter Property="MaxHeight" Value="57" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMemoryHookExpanded}" Value="True">
                                                    <Setter Property="MaxHeight" Value="Infinity" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <!-- Floating action toast overlay to avoid jumping card height -->
                <Border Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Padding="12,6"
                        CornerRadius="16"
                        Background="{DynamicResource ToastSurfaceBrush}"
                        IsHitTestVisible="False"
                        Visibility="{Binding ActionStatusText, Converter={StaticResource StringToVis}}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2" Color="#000000" />
                    </Border.Effect>
                    <TextBlock Text="{Binding ActionStatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource ToastForegroundBrush}" />
                </Border>
            </Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <!-- Mini Footer -->
                    <Grid x:Name="MiniFooter" Visibility="{Binding IsMiniMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:Button Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryActionButton}" Padding="10,5" MinHeight="28" FontSize="{StaticResource CaptionFontSize}" ToolTip="存入生词库（Enter）" />
                        <ui:Button Grid.Column="1" Command="{Binding SpeakCommand}" Style="{StaticResource UtilityIconButton}" Margin="6,0,0,0" Width="28" Height="28" ToolTip="朗读" AutomationProperties.Name="朗读">
                            <controls:CrispSymbolIcon Symbol="Speaker220" FontSize="14" />
                        </ui:Button>
                        <ui:Button Grid.Column="3" x:Name="ExpandCardButton" Content="展开" Command="{Binding ExpandToFullCommand}" Style="{StaticResource QuietActionButton}" Padding="10,4" MinHeight="28" FontSize="{StaticResource CaptionFontSize}" ToolTip="展开完整卡片（Tab）" />
                    </Grid>
                    <!-- Full Footer -->
                    <Grid x:Name="FullFooter" Visibility="{Binding IsFullCard, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ui:Button x:Name="SaveWordButton" Content="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryActionButton}" ToolTip="存入生词库（Enter）" />
                        <ui:Button Grid.Column="1" Content="{Binding AiButtonText}" Command="{Binding ForceAiCommand}" IsEnabled="{Binding CanSave}" HorizontalAlignment="Left" Margin="6,0,0,0" Style="{StaticResource PopupButton}" Background="{DynamicResource AccentSubtleBrush}" Foreground="{DynamicResource AccentBrush}" ToolTip="结合语境生成 AI 详解（Ctrl+Enter）" />
                        <ui:Button Grid.Column="2" Style="{StaticResource UtilityIconButton}" Command="{Binding ToggleEditDefinitionCommand}" Margin="0,0,4,0" ToolTip="保存前修改释义" AutomationProperties.Name="编辑释义">
                            <controls:CrispSymbolIcon Symbol="Edit20" FontSize="15" />
                        </ui:Button>
                        <ui:Button Grid.Column="3" Style="{StaticResource UtilityIconButton}" Command="{Binding CopyResultCommand}" ToolTip="复制单词与释义（Ctrl+C）" AutomationProperties.Name="复制词条">
                            <controls:CrispSymbolIcon Symbol="Copy20" FontSize="15" />
                        </ui:Button>
                    </Grid>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding SavedStatusText, Converter={StaticResource StringToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SavedStatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Grid.Column="1" Content="撤销" Command="{Binding UndoSaveCommand}" Visibility="{Binding CanUndoSave, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsUndoingSave, Converter={StaticResource InverseBool}}" Style="{StaticResource QuietActionButton}" Padding="6,2" MinHeight="24" MinWidth="0" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" ToolTip="撤销本次本地收藏" AutomationProperties.Name="撤销本地收藏" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding SyncStatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding SyncStatusText, Converter={StaticResource StringToVis}}" />
                    <TextBlock x:Name="ShortcutHintTextBlock" Text="{Binding ShortcutHintText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
