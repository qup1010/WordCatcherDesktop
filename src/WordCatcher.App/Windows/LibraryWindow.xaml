<Window x:Class="WordCatcher.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
        xmlns:views="clr-namespace:WordCatcher.App.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:WordCatcher.App.Controls"
        xmlns:converters="clr-namespace:WordCatcher.App.Converters"
        xmlns:models="clr-namespace:WordCatcher.Core.Models;assembly=WordCatcher.Core"
        xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Word Catcher"
        Icon="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.ico"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource UiFontFamily}"
        Background="{DynamicResource CanvasBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/WordCatcher.App;component/Themes/DesignSystem.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:SyncStatusLabelConverter x:Key="SyncStatusLabel" />
        <converters:LocalDateTimeConverter x:Key="LocalTime" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="WindowCaptionButton" TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="4" BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="3" /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource WindowCaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ListItemHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="40">
                            <Border x:Name="TabBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource SelectedSurfaceBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Divider"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Divider" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageHostTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsPresenter Grid.Row="0" Visibility="Collapsed" />
                            <Border Grid.Row="1" Background="Transparent" ClipToBounds="True">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                  Margin="24,20,24,20" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCategoryHostTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsPresenter Grid.Row="0" Visibility="Collapsed" />
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Panel.ZIndex="10" Background="{DynamicResource TitleBarGlassBrush}" BorderThickness="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BrandColumn" Width="208" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                           Width="20" Height="20" Stretch="Uniform" />
                    <TextBlock x:Name="BrandText" Text="Word Catcher" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel x:Name="CaptionButtonsPanel" Grid.Column="2" Panel.ZIndex="20" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button x:Name="MinimizeButton" Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" />
                    </ui:Button>
                    <ui:Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButton}"
                            Click="MaximizeButton_Click" ToolTip="最大化" AutomationProperties.Name="最大化">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" />
                    </ui:Button>
                    <ui:Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}"
                            Click="CloseButton_Click" ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationRailBorder" Grid.Column="0" Background="Transparent" BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:NavigationView x:Name="AppNavigation"
                                       PaneDisplayMode="Left"
                                       IsPaneOpen="True"
                                       IsPaneToggleVisible="False"
                                       IsBackButtonVisible="Collapsed"
                                       HeaderVisibility="Collapsed"
                                       IsFooterSeparatorVisible="True"
                                       OpenPaneLength="208"
                                       CompactPaneLength="64"
                                       FrameMargin="0">
                        <ui:NavigationView.MenuItems>
                            <ui:NavigationViewItem x:Name="LibraryNavigationItem" ToolTip="生词库（Ctrl+1）" Content="生词库" Tag="Library"
                                                   Icon="{controls:CrispIcon Book24}" IsActive="True"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                            <ui:NavigationViewItem x:Name="LookupNavigationItem" ToolTip="查词（Ctrl+2）" Content="查词" Tag="Lookup"
                                                   Icon="{controls:CrispIcon Search24}"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                            <ui:NavigationViewItem x:Name="SyncNavigationItem" ToolTip="WebDAV 与 Anki 同步（Ctrl+3）" Content="同步状态" Tag="Sync"
                                                   Icon="{controls:CrispIcon ArrowSync24}"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                        </ui:NavigationView.MenuItems>
                        <ui:NavigationView.FooterMenuItems>
                            <ui:NavigationViewItem x:Name="SettingsNavigationItem" ToolTip="设置（Ctrl+4）" Content="设置" Tag="Settings"
                                                   Icon="{controls:CrispIcon Settings24}"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                        </ui:NavigationView.FooterMenuItems>
                    </ui:NavigationView>

                    <Border x:Name="NavigationHint" Grid.Row="1" Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Margin="12,4,12,14" Padding="10,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="取词" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppliedHotkey}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="截屏" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppliedOcrHotkey}" Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="MainWorkspaceSurface"
                    Grid.Column="1"
                    Background="{DynamicResource CanvasLayerBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="8,0,0,0"
                    ClipToBounds="True">
                <TabControl x:Name="MainTabs"
                            Style="{StaticResource PageHostTabControl}"
                            RenderTransformOrigin="0.5,0.5">
                    <TabControl.RenderTransform>
                        <TranslateTransform x:Name="MainTabsTransform" Y="0" />
                    </TabControl.RenderTransform>

            <!-- ================= TAB 1: 词库 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="LibraryTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:CrispSymbolIcon Symbol="Book24" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="生词库" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="生词库" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="查看收藏的单词、释义和原句"
                                       Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="StartReviewButton" Command="{Binding StartReviewCommand}"
                                    Style="{StaticResource SecondaryActionButton}"
                                    ToolTip="对当前列表中的词条与语境进行卡片自测复习"
                                    Margin="0,0,8,0"
                                    MinHeight="34"
                                    Padding="12,5"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    FontSize="{StaticResource CaptionFontSize}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:CrispSymbolIcon Symbol="Flash20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StartReviewButtonText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="SyncWebDavButton" Command="{Binding SyncWebDavCommand}"
                                    ToolTip="与 WebDAV 云端合并同步词库"
                                    Margin="0,0,8,0"
                                    Padding="12,5"
                                    FontSize="{StaticResource CaptionFontSize}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryActionButton}">
                                        <Setter Property="MinHeight" Value="34" />
                                        <Setter Property="IsEnabled" Value="{Binding IsSyncingWebDav, Converter={StaticResource InverseBool}}" />
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <controls:CrispSymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="云端同步" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncingWebDav}" Value="True">
                                                        <Setter Property="Text" Value="同步中…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ui:Button>
                            <ToggleButton x:Name="LibraryMoreButton" Margin="0,0,10,0" Padding="9,5" MinHeight="34"
                                          Background="{DynamicResource SurfaceBrush}"
                                          BorderBrush="{DynamicResource ControlBorderBrush}"
                                          BorderThickness="1"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          FontSize="{StaticResource CaptionFontSize}"
                                          Cursor="Hand"
                                          ToolTip="导入或导出词库备份" AutomationProperties.Name="更多词库操作">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:CrispSymbolIcon Symbol="MoreHorizontal20" FontSize="15"
                                                               TextOptions.TextFormattingMode="Ideal"
                                                               TextOptions.TextRenderingMode="Grayscale" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=LibraryMoreButton, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=LibraryMoreButton}"
                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <Border Margin="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="148">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" Opacity="0.15" ShadowDepth="3" Color="#000000" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <ui:Button x:Name="ImportBackupButton" Command="{Binding ImportJsonCommand}"
                                                ToolTip="导入桌面端或浏览器插件导出的 JSON 词库备份"
                                                Style="{StaticResource QuietActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,7" Foreground="{DynamicResource TextPrimaryBrush}"
                                                IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:CrispSymbolIcon Symbol="ArrowDownload20" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="导入备份" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                        <ui:Button x:Name="ExportBackupButton" Command="{Binding ExportJsonCommand}"
                                                ToolTip="导出全部词条与语境，不受当前搜索和筛选影响"
                                                Style="{StaticResource QuietActionButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,7" Foreground="{DynamicResource TextPrimaryBrush}"
                                                IsEnabled="{Binding IsExporting, Converter={StaticResource InverseBool}}">
                                            <StackPanel Orientation="Horizontal">
                                                <controls:CrispSymbolIcon Symbol="ArrowUpload20" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="导出备份" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <TextBlock Text="{Binding Words.Count, StringFormat={}{0} 个词条}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                        <Grid x:Name="LibraryWorkspace">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Words.Count}" Value="0" />
                                                <Condition Binding="{Binding SourceFilter}" Value="" /><Condition Binding="{Binding SearchQuery}" Value="" /><Condition Binding="{Binding SelectedFilterIndex}" Value="0" /><Condition Binding="{Binding CanUndoDelete}" Value="False" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" /><Condition Binding="{Binding HasLoadError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LibraryListColumn" Width="300" MinWidth="250" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                        <GridSplitter Grid.Column="1"
                                      Width="9"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Style="{StaticResource WorkspaceSplitterStyle}"
                                      ToolTip="拖动调整列表与详情宽度" />
                        <!-- Left: Search & Word List -->
                        <Border Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Search Bar -->
                                <StackPanel Grid.Row="0"><Grid Grid.Row="0" Margin="0,0,0,10" IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}">
                                    <ui:TextBox x:Name="SearchBox"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="搜索单词、释义、备注或原句"
                                             ClearButtonEnabled="False"
                                             MinHeight="36"
                                             Padding="32,6,32,6"
                                             FontSize="13"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             Background="{DynamicResource SurfaceBrush}"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{DynamicResource ControlBorderBrush}"
                                             BorderThickness="1"
                                             ToolTip="输入即搜索；Ctrl+F 聚焦，Esc 清空搜索"
                                             KeyDown="SearchBox_KeyDown" />
                                    <controls:CrispSymbolIcon Symbol="Search20"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="11,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False" />
                                    <ui:Button Command="{Binding ClearSearchCommand}"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Visibility="{Binding SearchQuery, Converter={StaticResource StringToVis}}"
                                            ToolTip="清空搜索">
                                        <controls:CrispSymbolIcon Symbol="Dismiss16" FontSize="12" />
                                    </ui:Button>
                                </Grid>
                                    <Grid Margin="0,0,0,8" IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ResultCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultCountText}" />
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedSortIndex}" Width="112" MinHeight="28" Padding="6,2" FontSize="12" Margin="6,0" AutomationProperties.Name="词条排序">
                                            <ComboBoxItem Content="最近更新" /><ComboBoxItem Content="单词 A–Z" /><ComboBoxItem Content="最近收藏" />
                                        </ComboBox>
                                        <ToggleButton x:Name="LibraryFilterButton" Grid.Column="2" Content="{Binding FilterButtonText}" Padding="8,4" MinHeight="28" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="按状态和来源应用筛选" />
                                        <Popup IsOpen="{Binding IsChecked, ElementName=LibraryFilterButton, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LibraryFilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <Border Margin="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Width="290">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" Opacity="0.15" ShadowDepth="3" Color="#000000" />
                                                </Border.Effect>
                                                <StackPanel>
                                                    <TextBlock Text="筛选词条" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />
                                                    <TextBlock Text="词条状态" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                    <ComboBox SelectedIndex="{Binding SelectedFilterIndex}" MinHeight="34" Margin="0,0,0,12" AutomationProperties.Name="按同步状态筛选生词">
                                                        <ComboBoxItem Content="全部词条" /><ComboBoxItem Content="待同步" /><ComboBoxItem Content="同步失败" /><ComboBoxItem Content="最近 7 天收藏" /><ComboBoxItem Content="有备注" /><ComboBoxItem Content="无备注" />
                                                    </ComboBox>
                                                    <TextBlock Text="来源应用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                    <ui:TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="如 chrome、WeChat" MinHeight="34" AutomationProperties.Name="按来源应用过滤" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <WrapPanel>
                                        <ui:Button Content="{Binding FilterTagText}" Command="{Binding ClearStatusFilterCommand}" Visibility="{Binding FilterTagText, Converter={StaticResource StringToVis}}" Style="{StaticResource QuietActionButton}" Padding="8,3" FontSize="12" Margin="0,0,6,8" ToolTip="移除词条状态筛选" />
                                        <ui:Button Content="{Binding SourceTagText}" Command="{Binding ClearSourceFilterCommand}" Visibility="{Binding SourceTagText, Converter={StaticResource StringToVis}}" Style="{StaticResource QuietActionButton}" Padding="8,3" FontSize="12" Margin="0,0,0,8" MaxWidth="200" ToolTip="移除来源应用筛选" />
                                    </WrapPanel>
</StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,8"
                                            Visibility="{Binding HasMultipleSelectedWords, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding BatchSelectionText}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <ui:Button Grid.Column="1" Content="删除所选" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource QuietActionButton}" Foreground="{DynamicResource DangerBrush}" Padding="8,4" MinHeight="26" FontSize="12" />
                                        </Grid>
                                    </Border>
                                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <CheckBox Content="紧凑列表" IsChecked="{Binding IsCompact}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <CheckBox Content="遮挡释义" IsChecked="{Binding IsDefinitionMasked}" VerticalAlignment="Center" ToolTip="在列表与详情中先隐藏中文释义，方便主动回忆" />
                                    </WrapPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,5,0,0" Visibility="{Binding ShowContextSentenceActions, Converter={StaticResource BoolToVis}}">
                                            <ui:Button Content="{Binding ContextSentenceButtonText}" Command="{Binding RetryContextSentenceCommand}"
                                                       Style="{StaticResource QuietActionButton}" Padding="8,4" Margin="0,0,6,0" />
                                            <ui:Button Content="改用 AI" Command="{Binding UseAiFailedContextSentenceCommand}"
                                                       Visibility="{Binding CanUseAiContextSentence, Converter={StaticResource BoolToVis}}"
                                                       Style="{StaticResource QuietActionButton}" Padding="8,4" />
                                        </WrapPanel>
                                    </StackPanel><StackPanel Margin="0,8,0,0" Visibility="{Binding DeleteStatusText, Converter={StaticResource StringToVis}}">
<TextBlock Text="{Binding DeleteStatusText}" TextWrapping="Wrap" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
<ui:Button Content="撤销删除" Style="{StaticResource SecondaryActionButton}" Command="{Binding UndoDeleteCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVis}}" />
</StackPanel>
                                    <ui:Button Content="重新加载" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Content="加载更多词条" Command="{Binding LoadMoreCommand}" Margin="0,8,0,0" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- Words ListBox -->
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="WordList"
                                             SelectionMode="Extended"
                                             SelectionChanged="WordList_SelectionChanged"
                                             ItemsSource="{Binding Words}"
                                             IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             SelectedItem="{Binding SelectedWord, Mode=TwoWay}"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,8"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding DisplayWord}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{StaticResource BodyFontSize}"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding DefinitionSummary}"
                                                                   FontSize="{StaticResource CaptionFontSize}"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsDefinitionMasked, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.08" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <controls:CrispSymbolIcon Symbol="Book24" FontSize="28"
                                                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EmptyMessage}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=WordList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right: Word Detail & Occurrences / Edit View -->
                        <Border Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="22">
                            <Grid>
                                <!-- No selection prompt -->
                                            <TextBlock Text="选择一个词条，查看释义与语境" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Selected Word View / Edit Area -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Scrollable Main Content -->
                                    <ScrollViewer x:Name="DetailScroll" Grid.Row="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0,0,10,0">
                                        <StackPanel>
                                            <!-- In-App Flashcard Review Mode -->
                                            <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="20,18"
                                                    Margin="0,0,0,18"
                                                    Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="语境自测复习" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                            </Border>
                                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="8,0,0,0"
                                                                    Visibility="{Binding ReviewScopeLabel, Converter={StaticResource StringToVis}}">
                                                                <TextBlock Text="{Binding ReviewScopeLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ReviewProgressText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                       Visibility="{Binding IsActiveReviewCard, Converter={StaticResource BoolToVis}}" />
                                                            <Border Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0"
                                                                    Visibility="{Binding MarkedAgainBadgeText, Converter={StaticResource StringToVis}}">
                                                                <TextBlock Text="{Binding MarkedAgainBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <ui:Button Content="乱序" Command="{Binding ShuffleReviewCommand}" Style="{StaticResource QuietActionButton}" Padding="10,4" Margin="0,0,6,0" ToolTip="随机打乱复习顺序" />
                                                            <ui:Button Content="退出复习" Command="{Binding ExitReviewCommand}" Style="{StaticResource QuietActionButton}" Padding="10,4" ToolTip="退出复习模式（Esc）" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Active Review Card -->
                                                    <StackPanel Visibility="{Binding IsActiveReviewCard, Converter={StaticResource BoolToVis}}">
                                                    <!-- Front: Context Sentence Prompt -->
                                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                                        <StackPanel>
                                                            <TextBlock Text="请根据以下真实语境回忆词义与用法：" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />
                                                            <TextBlock x:Name="ReviewPromptTextBlock" FontSize="16" FontWeight="Medium" LineHeight="26" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"><Run x:Name="ReviewPromptPrefixRun" Text="{Binding ReviewPromptPrefix, Mode=OneWay}" /><Run x:Name="ReviewPromptHighlightRun" Text="{Binding ReviewPromptHighlight, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSubtleBrush}" FontWeight="SemiBold" TextDecorations="Underline" /><Run x:Name="ReviewPromptSuffixRun" Text="{Binding ReviewPromptSuffix, Mode=OneWay}" /></TextBlock>
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <Border x:Name="ReviewFallbackTargetBadge" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,8,0"
                                                                        Visibility="{Binding ReviewFallbackTargetWord, Converter={StaticResource StringToVis}}">
                                                                    <TextBlock FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"><Run Text="目标词：" /><Run Text="{Binding ReviewFallbackTargetWord, Mode=OneWay}" /></TextBlock>
                                                                </Border>
                                                                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                                        Visibility="{Binding CurrentReviewWord.PartOfSpeech, Converter={StaticResource StringToVis}}">
                                                                    <TextBlock Text="{Binding CurrentReviewWord.PartOfSpeech}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ReviewSourceSummary}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                                                           Visibility="{Binding ReviewSourceSummary, Converter={StaticResource StringToVis}}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Back: Answer Area -->
                                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                                                            Visibility="{Binding IsAnswerRevealed, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding ReviewEffectiveExpression}" FontFamily="{StaticResource HeadwordFontFamily}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding CurrentReviewWord.Reading}" FontFamily="{StaticResource PhoneticFontFamily}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                           Visibility="{Binding CurrentReviewWord.Reading, Converter={StaticResource StringToVis}}" />
                                                                <ui:Button Command="{Binding SpeakWordCommand}" Style="{StaticResource QuietActionButton}" Padding="8,4" Margin="10,0,0,0" ToolTip="朗读（快捷键 P）">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <controls:CrispSymbolIcon Symbol="Speaker220" FontSize="14" VerticalAlignment="Center" />
                                                                        <TextBlock Text="朗读" Margin="5,0,0,0" FontSize="{StaticResource CaptionFontSize}" />
                                                                    </StackPanel>
                                                                </ui:Button>
                                                            </WrapPanel>

                                                            <TextBlock Text="{Binding ReviewEffectiveDefinition}" FontSize="15" FontWeight="Medium" LineHeight="23" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ReviewEffectiveTranslation}" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Visibility="{Binding ReviewEffectiveTranslation, Converter={StaticResource StringToVis}}" />

                                                            <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                                                    Visibility="{Binding ReviewEffectiveKeyExplanation, Converter={StaticResource StringToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="语境解析" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                    <TextBlock Text="{Binding ReviewEffectiveKeyExplanation}" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                                                    Visibility="{Binding ReviewEffectiveNote, Converter={StaticResource StringToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="个人笔记" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                    <TextBlock Text="{Binding ReviewEffectiveNote}" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{DynamicResource AmberHookSurfaceBrush}" BorderBrush="{DynamicResource AmberHookBorderBrush}" BorderThickness="3,0,0,0" CornerRadius="0,6,6,0" Padding="10,8" Margin="0,8,0,0"
                                                                    Visibility="{Binding CurrentReviewWord.MemoryHook, Converter={StaticResource StringToVis}}">
                                                                <TextBlock Foreground="{DynamicResource AmberHookTextBrush}" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                                                                    <Run Text="记忆线索：" FontWeight="SemiBold" Foreground="{DynamicResource AmberHookLabelBrush}" />
                                                                    <Run Text="{Binding CurrentReviewWord.MemoryHook}" />
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Review Controls -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:Button Content="上一张 (←)" Command="{Binding PrevReviewCardCommand}" IsEnabled="{Binding CanGoPrevReviewCard}" Style="{StaticResource SecondaryActionButton}" Padding="14,7" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="12,0">
                                                            <ui:Button Command="{Binding ToggleAnswerCommand}" Style="{StaticResource PrimaryActionButton}" Padding="22,7">
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="显示答案 (Space)" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAnswerRevealed}" Value="True">
                                                                                    <Setter Property="Text" Value="隐藏答案 (Space)" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </ui:Button>
                                                            <ui:Button Content="{Binding MarkAgainButtonText}" Command="{Binding ToggleMarkReviewAgainCommand}" Padding="12,7" Margin="8,0,0,0" ToolTip="标记为本轮结束后再练（快捷键 M）">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryActionButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCurrentReviewMarkedAgain}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource AmberHookSurfaceBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource AmberHookLabelBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource AmberHookBorderBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                            </ui:Button>
                                                        </StackPanel>
                                                        <ui:Button Grid.Column="2" Content="{Binding NextReviewButtonText}" Command="{Binding NextReviewCardCommand}" Style="{StaticResource SecondaryActionButton}" Padding="14,7" />
                                                    </Grid>
                                                    </StackPanel>

                                                    <!-- Round Completion Summary -->
                                                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,18"
                                                            Visibility="{Binding IsReviewCompleted, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <TextBlock Text="本轮复习完成" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding ReviewCompletionSummary}" FontSize="14" LineHeight="22" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                                                            <WrapPanel>
                                                                <ui:Button Content="{Binding PracticeMarkedButtonText}" Command="{Binding PracticeMarkedAgainCommand}"
                                                                           Style="{StaticResource PrimaryActionButton}" Padding="16,7" Margin="0,0,8,8"
                                                                           Visibility="{Binding HasMarkedAgainItems, Converter={StaticResource BoolToVis}}" />
                                                                <ui:Button Content="再练本轮" Command="{Binding RestartReviewCommand}" Style="{StaticResource SecondaryActionButton}" Padding="14,7" Margin="0,0,8,8" />
                                                                <ui:Button Content="乱序重练" Command="{Binding ShuffleReviewCommand}" Style="{StaticResource SecondaryActionButton}" Padding="14,7" Margin="0,0,8,8" />
                                                                <ui:Button Content="回到上一张" Command="{Binding PrevReviewCardCommand}" Style="{StaticResource QuietActionButton}" Padding="12,7" Margin="0,0,8,8" />
                                                                <ui:Button Content="返回生词库" Command="{Binding ExitReviewCommand}" Style="{StaticResource QuietActionButton}" Padding="12,7" Margin="0,0,0,8" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Normal Display Mode -->
                                            <StackPanel x:Name="WordDetailsPanel">
                                                <StackPanel.Style><Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReviewMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></StackPanel.Style>
                                                <!-- Header: Word, Reading, POS, Speak -->
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedWord.DisplayWord}"
                                                               FontFamily="{StaticResource HeadwordFontFamily}"
                                                               TextWrapping="Wrap" FontSize="26"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedWord.Reading}"
                                                               FontFamily="{StaticResource PhoneticFontFamily}"
                                                               FontSize="15"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <ui:Button Command="{Binding SpeakWordCommand}"
                                                               Style="{StaticResource QuietActionButton}"
                                                               Padding="8,4"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="朗读当前词条">
                                                        <StackPanel Orientation="Horizontal">
                                                            <controls:CrispSymbolIcon Symbol="Speaker220" FontSize="14" VerticalAlignment="Center" />
                                                            <TextBlock Text="朗读" FontSize="{StaticResource CaptionFontSize}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <Border Margin="10,0,0,0"
                                                            Background="{DynamicResource AccentSubtleBrush}"
                                                            CornerRadius="4"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding SelectedWord.PartOfSpeech, Converter={StaticResource StringToVis}}">
                                                        <TextBlock Text="{Binding SelectedWord.PartOfSpeech}"
                                                                   FontSize="{StaticResource CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Definition Text -->
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,18">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding WordDefinitionLabel}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding SelectedWord.Definition}" FontSize="{StaticResource BodyFontSize}" LineHeight="24" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefinitionMasked}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.08" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Occurrence Records Card -->
                                                <Border Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="8"
                                                        Padding="0"
                                                        Margin="0,16,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <TextBlock Text="{Binding SavedSentencesTitle}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                                                        </StackPanel>
                                                        <ListBox x:Name="OccurrenceList"
                                                                 ItemsSource="{Binding Occurrences}"
                                                                 SelectedItem="{Binding SelectedOccurrence, Mode=TwoWay}"
                                                                 SelectionChanged="OccurrenceList_SelectionChanged"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="Margin" Value="0" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                                <ContentPresenter />
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="14,12"
                                                                            CornerRadius="8"
                                                                            Margin="0,0,0,10">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                                                <Setter Property="BorderThickness" Value="1" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DefinitionLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" Visibility="{Binding AdditionalDefinition, Converter={StaticResource StringToVis}}" />
                                                                            <TextBlock Text="{Binding AdditionalDefinition}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"
                                                                                       Visibility="{Binding AdditionalDefinition, Converter={StaticResource StringToVis}}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsDefinitionMasked, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                                <Setter Property="Opacity" Value="0.08" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding Sentence}" Margin="0,4,0,0"
                                                                                       TextWrapping="Wrap"
                                                                                       FontSize="14"
                                                                                       FontWeight="Medium"
                                                                                       LineHeight="22" Foreground="{DynamicResource TextPrimaryBrush}" />

                                                                            <WrapPanel Margin="0,6,0,4" Visibility="{Binding SupplementaryExpression, Converter={StaticResource StringToVis}}">
                                                                                <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="核心表达" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Expression}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                            </WrapPanel>



                                                                            <TextBlock Text="{Binding Translation}"
                                                                                       FontSize="{StaticResource CaptionFontSize}"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="0,4,0,0"
                                                                                       LineHeight="19"
                                                                                       Visibility="{Binding Translation, Converter={StaticResource StringToVis}}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsDefinitionMasked, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                                <Setter Property="Opacity" Value="0.08" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <!-- Personal Note Highlighted Directly -->
                                                                            <Border Background="{DynamicResource AccentSubtleBrush}" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                                                    Visibility="{Binding Note, Converter={StaticResource StringToVis}}">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="个人笔记" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                                    <TextBlock Text="{Binding Note}" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <Expander Header="{Binding ExplanationLabel}" Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                                                                <StackPanel Margin="0,6,0,0">
                                                                                    <StackPanel Visibility="{Binding KeyExplanation, Converter={StaticResource StringToVis}}" Margin="0,0,0,6">
                                                                                        <TextBlock Text="语境解析" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                                        <TextBlock Text="{Binding KeyExplanation}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Visibility="{Binding UsageNote, Converter={StaticResource StringToVis}}" Margin="0,0,0,6">
                                                                                        <TextBlock Text="用法提示" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                                        <TextBlock Text="{Binding UsageNote}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Visibility="{Binding Example, Converter={StaticResource StringToVis}}">
                                                                                        <TextBlock Text="拓展例句" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                                                                                        <TextBlock Text="{Binding Example}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                                                        <TextBlock Text="{Binding ExampleTranslation}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding ExampleTranslation, Converter={StaticResource StringToVis}}" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Expander>

                                                                            <Grid Margin="0,8,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="{StaticResource CaptionFontSize}"
                                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                                           VerticalAlignment="Center">
                                                                                    <Run Text="来源  " />
                                                                                    <Run Text="{Binding SourceProcess}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    <Run Text=" · " />
                                                                                    <Run Text="{Binding SourceWindowTitle}" />
                                                                                    <Run Text=" · " />
                                                                                    <Run Text="{Binding CapturedAtUtc, Converter={StaticResource LocalTime}}" />
                                                                                </TextBlock>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                                    <ui:Button Content="查看原文"
                                                                                               Command="{Binding DataContext.OpenSourceUriCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                               CommandParameter="{Binding SourceUri}"
                                                                                               Style="{StaticResource QuietActionButton}"
                                                                                               Padding="8,4"
                                                                                               Margin="0,0,6,0"
                                                                                               Visibility="{Binding SourceUri, Converter={StaticResource StringToVis}}" />
                                                                                    <ui:Button Content="翻译原句"
                                                                                               Command="{Binding DataContext.TranslateOccurrenceSentenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                               CommandParameter="{Binding}"
                                                                                               Style="{StaticResource QuietActionButton}"
                                                                                               Padding="8,4"
                                                                                               Margin="0,0,6,0"
                                                                                               IsEnabled="{Binding DataContext.IsTranslatingContextSentence, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBool}}"
                                                                                               Visibility="{Binding Sentence, Converter={StaticResource StringToVis}}" />
                                                                                    <ui:Button Content="编辑语境"
                                                                                               Command="{Binding DataContext.EditContextCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                               CommandParameter="{Binding}"
                                                                                               Style="{StaticResource QuietActionButton}"
                                                                                               Padding="8,4" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <StackPanel Visibility="{Binding IsEditingContext, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                                            <TextBlock Text="语境释义" />
                                                            <ui:TextBox Text="{Binding ContextDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                                            <Grid>
                                                                <TextBlock Text="原句翻译" VerticalAlignment="Center" />
                                                                <WrapPanel HorizontalAlignment="Right">
                                                                <ui:Button Content="{Binding ContextSentenceButtonText}"
                                                                           Command="{Binding RetryContextSentenceCommand}"
                                                                           IsEnabled="{Binding IsTranslatingContextSentence, Converter={StaticResource InverseBool}}"
                                                                           Style="{StaticResource QuietActionButton}"
                                                                           Padding="6,2" />
                                                                <ui:Button Content="改用 AI"
                                                                           Command="{Binding UseAiOccurrenceSentenceCommand}"
                                                                           Visibility="{Binding CanUseAiContextSentence, Converter={StaticResource BoolToVis}}"
                                                                           IsEnabled="{Binding IsTranslatingContextSentence, Converter={StaticResource InverseBool}}"
                                                                           Style="{StaticResource QuietActionButton}"
                                                                           Padding="6,2" Margin="4,0,0,0" />
                                                                </WrapPanel>
                                                            </Grid>
                                                            <ui:TextBox Text="{Binding ContextTranslation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                                            <TextBlock Text="个人笔记" />
                                                            <ui:TextBox Text="{Binding ContextNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                                            <WrapPanel>
                                                                <ui:Button Content="保存语境" Command="{Binding SaveContextEditCommand}" Style="{StaticResource PrimaryActionButton}" />
                                                                <ui:Button Content="取消" Command="{Binding CancelContextEditCommand}" Style="{StaticResource SecondaryActionButton}" Margin="8,0,0,0" />
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,16,0,12">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=OccurrenceList, Path=HasItems}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="暂无语境记录"
                                                                       FontWeight="Medium"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="屏幕取词时会尝试记录原句与来源。"
                                                                       FontSize="{StaticResource CaptionFontSize}"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Expander Header="记忆线索" Visibility="{Binding SelectedWord.MemoryHook, Converter={StaticResource StringToVis}}" Margin="0,12,0,0">
                                                <!-- Memory Hook (Amber Callout matching Extension & Anki) -->
                                                <Border Background="{DynamicResource AmberHookSurfaceBrush}"
                                                        BorderBrush="{DynamicResource AmberHookBorderBrush}"
                                                        BorderThickness="3,0,0,0"
                                                        CornerRadius="0,8,8,0"
                                                        Padding="12,10"
                                                        Margin="0,0,0,16"
                                                        Visibility="{Binding SelectedWord.MemoryHook, Converter={StaticResource StringToVis}}">
                                                    <TextBlock Foreground="{DynamicResource AmberHookTextBrush}" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                                                        <Run Text="记忆线索：" FontWeight="SemiBold" Foreground="{DynamicResource AmberHookLabelBrush}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding SelectedWord.MemoryHook}" />
                                                    </TextBlock>
                                                </Border>

                                                </Expander>
                                            </StackPanel>

                                            <!-- Edit Mode Form -->
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBool}}">
                                                <TextBlock Text="编辑词条" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                                <TextBlock Text="单词 / 原形" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="EditWordBox" Text="{Binding EditWordText, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="音标" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditReading, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="词性" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditPartOfSpeech, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="释义" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,8" FontSize="13"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                         Height="100"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         Margin="0,0,0,10" />

                                                <TextBlock Text="记忆线索" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditMemoryHook, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource SurfaceBrush}"
                                                         BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,14" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Bottom Action Buttons -->
                                    <Border Grid.Row="1"
                                            Visibility="{Binding IsReviewMode, Converter={StaticResource InverseBoolToVis}}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0"
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                        <Grid>
                                            <!-- Normal Mode Actions -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <ui:Button Content="复制" Command="{Binding CopyWordCommand}" Style="{StaticResource QuietActionButton}" ToolTip="复制单词与释义" Margin="0,0,8,0" />
                                                <ui:Button Content="编辑" Style="{StaticResource SecondaryActionButton}" ToolTip="编辑词条（F2）"
                                                        Command="{Binding StartEditCommand}"
                                                        Padding="14,6"
                                                        Margin="0,0,8,0"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                                <ui:Button Content="更多 ···" Click="OpenActionMenu_Click" Style="{StaticResource QuietActionButton}" ToolTip="更多词条操作" AutomationProperties.Name="更多词条操作">
                                                    <ui:Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="删除词条" Command="{Binding DeleteWordCommand}" ToolTip="删除后可撤销；Anki 中的卡片会保留">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                                                                            <Border x:Name="MenuSurface" Background="{DynamicResource SurfaceBrush}" Padding="14,8" CornerRadius="4"><TextBlock Text="{TemplateBinding Header}" Foreground="{DynamicResource DangerBrush}" FontSize="13" /></Border>
                                                                            <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="{DynamicResource DangerHoverSurfaceBrush}" /></Trigger></ControlTemplate.Triggers>
                                                                        </ControlTemplate></Setter.Value></Setter>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </ui:Button.ContextMenu>
                                                </ui:Button>
                                            </StackPanel>

                                            <TextBlock Text="Ctrl+S 保存" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                            <!-- Edit Mode Actions -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <ui:Button Content="保存修改" Style="{StaticResource PrimaryActionButton}" ToolTip="保存修改（Ctrl+S）"
                                                        Command="{Binding SaveEditCommand}" IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBool}}"
                                                        Padding="14,6"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Foreground="{DynamicResource OnAccentBrush}"
                                                        BorderThickness="0"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand" />
                                                <ui:Button Content="取消" Style="{StaticResource SecondaryActionButton}" ToolTip="放弃本次编辑（Esc）"
                                                        Command="{Binding CancelEditCommand}"
                                                        Padding="14,6"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                            </StackPanel>
                                        </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <Border x:Name="EmptyLibraryWorkspace"
                                Background="{DynamicResource SurfaceBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Words.Count}" Value="0" />
                                                <Condition Binding="{Binding SourceFilter}" Value="" /><Condition Binding="{Binding SearchQuery}" Value="" /><Condition Binding="{Binding SelectedFilterIndex}" Value="0" /><Condition Binding="{Binding CanUndoDelete}" Value="False" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" /><Condition Binding="{Binding HasLoadError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                                       Width="52"
                                       Height="52" />
                                <TextBlock Text="还没有收藏的词条"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="先查一个词并收藏；阅读时也可以选中文字后取词。"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" /><ui:Button Content="去查词" Tag="Lookup" Click="NavigationItem_Click" HorizontalAlignment="Center" Margin="0,16,0,0" Style="{StaticResource PrimaryActionButton}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: 查单词 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="LookupTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:CrispSymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="查词" />
                    </StackPanel>
                </TabItem.Header>
                <views:WordLookupView x:Name="LookupPage" />
            </TabItem>

            <!-- ================= TAB 3: 待同步 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="SyncTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:CrispSymbolIcon Symbol="ArrowSync24" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="同步状态" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="同步状态" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="查看词库同步结果，重试失败任务或处理冲突"
                                       Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryActionButton}" VerticalAlignment="Center"
                                   ToolTip="刷新同步状态" AutomationProperties.Name="刷新同步状态">
                            <StackPanel Orientation="Horizontal">
                                <controls:CrispSymbolIcon Symbol="ArrowSync20" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,8">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Border x:Name="WebDavSyncCard" Style="{StaticResource SurfaceCardStyle}" Padding="20,18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:CrispSymbolIcon Symbol="CloudSwap24" FontSize="22" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="WebDAV 词库同步" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WebDavTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding WebDavDescription}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding WebDavLastSuccess}" Visibility="{Binding WebDavLastSuccess, Converter={StaticResource StringToVis}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" />
                                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsWebDavBusy, Converter={StaticResource BoolToVis}}" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <ui:Button Content="立即同步" Visibility="{Binding IsWebDavEnabled, Converter={StaticResource BoolToVis}}" Command="{Binding RetryWebDavCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" />
                                            <ui:Button Content="前往设置" ToolTip="WebDAV 词库同步设置" Click="OpenWebDavSettings_Click" Style="{StaticResource SecondaryActionButton}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding WebDavActionMessage}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" Visibility="{Binding WebDavActionMessage, Converter={StaticResource StringToVis}}" />
                                        <ui:CardExpander Header="查看错误详情" Margin="0,12,0,0" Style="{StaticResource FluentSettingsExpanderStyle}"
                                                         Visibility="{Binding WebDavError, Converter={StaticResource StringToVis}}">
                                            <TextBox Text="{Binding WebDavError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </ui:CardExpander>
                                        <Border Margin="0,14,0,0" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"
                                                Visibility="{Binding HasWebDavConflict, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="检测到两端数据冲突：仅高亮存在差异的字段，请选择要保留的版本（所选版本及其删除状态将覆盖冲突记录）。" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" />
                                                <WrapPanel Margin="0,4,0,10">
                                                    <TextBlock Text="{Binding ConflictRecordId, StringFormat=记录：{0}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding ConflictSummaryText}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource WarningTextBrush}" />
                                                </WrapPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="92" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="12" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="本地版本" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Grid.Column="3" Text="云端版本" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding ConflictChangedFields}" Visibility="{Binding HasConflictChangedFields, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="82" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="12" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,2,8,0" />
                                                                    <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="8,6">
                                                                        <TextBox Text="{Binding LocalDisplay, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    </Border>
                                                                    <Border Grid.Column="3" Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="4" Padding="8,6">
                                                                        <TextBox Text="{Binding RemoteDisplay, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Expander Header="相同字段（点击展开核对）" Margin="0,2,0,10" Visibility="{Binding HasConflictUnchangedFields, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl ItemsSource="{Binding ConflictUnchangedFields}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,5">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="92" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                                                    <TextBox Grid.Column="1" Text="{Binding LocalDisplay, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <ui:Button Content="保留本地（覆盖云端）" Command="{Binding KeepLocalConflictCommand}" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Stretch" />
                                                    <ui:Button Grid.Column="2" Content="采用云端（覆盖本地）" Command="{Binding KeepRemoteConflictCommand}" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Stretch" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AnkiSyncCard" Style="{StaticResource SurfaceCardStyle}" Padding="20,18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <controls:CrispSymbolIcon Symbol="Flash24" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Anki 卡片同步" FontSize="16" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AnkiStatusLabel}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasActionableIssues}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding StateDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding AnkiSummary}" Visibility="{Binding AnkiSummary, Converter={StaticResource StringToVis}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <ui:Button Content="重试同步" Command="{Binding RetryAllCommand}" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" Visibility="{Binding HasActionableIssues, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button x:Name="OpenAnkiSettingsButton" Content="前往设置" Click="OpenAnkiSettings_Click" Style="{StaticResource SecondaryActionButton}" ToolTip="Anki 卡片同步设置" />
                                        </WrapPanel>

                                        <StackPanel Margin="0,18,0,0" Visibility="{Binding HasActionableIssues, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="需要处理的同步项" FontSize="{StaticResource BodyFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding IssueJobs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding Word.DisplayWord, TargetNullValue=未知单词}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding LastError}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource SyncStatusLabel}}"
                                                                           FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding MoreIssuesCount, StringFormat=另有 {0} 项未显示；重试同步仍会处理全部}"
                                                       FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"
                                                       Visibility="{Binding HasMoreIssues, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <ui:CardExpander x:Name="SyncHistoryExpander" Header="最近的 Anki 同步记录" Style="{StaticResource FluentSettingsExpanderStyle}"
                                                         Margin="0,16,0,0" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding RecentJobs}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,7">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="105" />
                                                                    <ColumnDefinition Width="125" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Word.DisplayWord, TargetNullValue=未知单词}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource SyncStatusLabel}}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Grid.Column="2" Text="{Binding UpdatedAtUtc, Converter={StaticResource LocalTime}}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </Border>

                                <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                <ui:InfoBar Style="{StaticResource FluentInfoBarStyle}" Severity="Informational" IsOpen="True" Margin="0,10,0,0"
                                        Title="同步消息" Message="{Binding StatusMessage}"
                                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= TAB 4: 设置 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="SettingsTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <controls:CrispSymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="设置" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                                <ui:TextBox x:Name="SettingsSearchBox"
                                            PlaceholderText="搜索设置项"
                                            ClearButtonEnabled="False"
                                            MinHeight="34"
                                            Padding="30,5,28,5"
                                            FontSize="13"
                                            TextChanged="SettingsSearchBox_TextChanged"
                                            KeyDown="SettingsSearchBox_KeyDown"
                                            AutomationProperties.Name="搜索设置项" />
                                <controls:CrispSymbolIcon Symbol="Search20" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                                          Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <ui:Button x:Name="ClearSettingsSearchButton"
                                           Click="ClearSettingsSearchButton_Click"
                                           Width="26" Height="26" Padding="0" Margin="0,0,3,0"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Background="Transparent" BorderThickness="0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="Collapsed"
                                           ToolTip="清空搜索">
                                    <controls:CrispSymbolIcon Symbol="Dismiss16" FontSize="12" />
                                </ui:Button>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="SettingsSearchResultHint"
                                   FontSize="{StaticResource CaptionFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                        <Border Margin="0,12,0,0"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                HorizontalAlignment="Left">
                            <WrapPanel x:Name="SettingsCategoryBar">
                                <RadioButton x:Name="GeneralCategoryTab"
                                             GroupName="SettingsCategoryGroup"
                                             Tag="0"
                                             IsChecked="True"
                                             Checked="SettingsCategoryTab_Checked"
                                             Style="{StaticResource SettingsCategoryTabStyle}"
                                             Content="常规与外观" />
                                <RadioButton x:Name="LookupCategoryTab"
                                             GroupName="SettingsCategoryGroup"
                                             Tag="1"
                                             Checked="SettingsCategoryTab_Checked"
                                             Style="{StaticResource SettingsCategoryTabStyle}"
                                             Content="查词与词典" />
                                <RadioButton x:Name="AiCategoryTab"
                                             GroupName="SettingsCategoryGroup"
                                             Tag="2"
                                             Checked="SettingsCategoryTab_Checked"
                                             Style="{StaticResource SettingsCategoryTabStyle}"
                                             Content="AI 详解" />
                                <RadioButton x:Name="SyncCategoryTab"
                                             GroupName="SettingsCategoryGroup"
                                             Tag="3"
                                             Checked="SettingsCategoryTab_Checked"
                                             Style="{StaticResource SettingsCategoryTabStyle}"
                                             Content="同步与联动" />
                                <RadioButton x:Name="AboutCategoryTab"
                                             GroupName="SettingsCategoryGroup"
                                             Tag="4"
                                             Checked="SettingsCategoryTab_Checked"
                                             Style="{StaticResource SettingsCategoryTabStyle}"
                                             Content="关于与更新" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>

                    <ScrollViewer x:Name="SettingsScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,12,8"
                                  IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="960" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TabControl x:Name="SettingsCategoryTabs"
                                        Grid.Column="0"
                                        SelectedIndex="0"
                                        Style="{StaticResource SettingsCategoryHostTabControl}"
                                        RenderTransformOrigin="0.5,0.5">
                                <TabControl.RenderTransform>
                                    <TranslateTransform x:Name="SettingsCategoryTransform" Y="0" />
                                </TabControl.RenderTransform>

                                <!-- Category 1: 常规与外观 -->
                                <TabItem x:Name="GeneralSettingsCategory" Header="常规与外观">
                                    <StackPanel x:Name="InteractionSettingsGroup">
                                        <TextBlock Text="窗口与主题" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="2,0,0,8" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Color24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="外观主题" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="切换浅色、深色或跟随 Windows 系统外观" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="148" MinHeight="34" VerticalAlignment="Center"
                                                      SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Tag"
                                                      AutomationProperties.Name="外观主题">
                                                <ComboBoxItem Content="浅色" Tag="Light" />
                                                <ComboBoxItem Content="深色" Tag="Dark" />
                                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                            </ComboBox>
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Pin24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="收藏后关闭浮窗" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="保存词条后自动收起取词浮窗；已固定浮窗保持打开" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding ClosePopupAfterSave}"
                                                             AutomationProperties.Name="收藏后关闭浮窗"
                                                             ToolTip="固定的浮窗会保持打开" />
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Apps24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="浮窗默认形态" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="极简译文仅显示翻译且右键可关闭；迷你卡片显示核心释义；按 Tab 均可展开完整卡片" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox x:Name="PopupDefaultModeBox" MinWidth="168" MinHeight="34" VerticalAlignment="Center"
                                                      SelectedValue="{Binding PopupDefaultMode, Mode=TwoWay}" SelectedValuePath="Tag"
                                                      AutomationProperties.Name="浮窗默认形态">
                                                <ComboBoxItem Content="极简译文" Tag="{x:Static models:UiSettings.PopupModeMinimal}" />
                                                <ComboBoxItem Content="迷你卡片" Tag="{x:Static models:UiSettings.PopupModeMini}" />
                                                <ComboBoxItem Content="完整卡片" Tag="{x:Static models:UiSettings.PopupModeFull}" />
                                            </ComboBox>
                                        </ui:CardControl>

                                        <TextBlock Text="全局快捷键" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Keyboard24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="取词快捷键" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding HotkeyHint}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,6"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Hotkey}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                                        <Setter Property="Text" Value="请按组合键…" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <ui:Button Content="恢复默认"
                                                           Command="{Binding ResetHotkeyCommand}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVis}}"
                                                           Margin="0,0,6,0"
                                                           ToolTip="填入 Ctrl+Shift+Z，保存后生效" />
                                                <ui:Button x:Name="RecordHotkeyButton"
                                                           Content="修改"
                                                           Command="{Binding RecordHotkeyCommand}"
                                                           Style="{StaticResource SecondaryActionButton}"
                                                           Visibility="{Binding IsRecordingHotkey, Converter={StaticResource InverseBoolToVis}}"
                                                           VerticalAlignment="Center" />
                                                <ui:Button Content="取消"
                                                           Command="{Binding CancelHotkeyRecordingCommand}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVis}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon ScanText24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="截屏 OCR 快捷键" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding OcrHotkeyHint}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource SubtleSurfaceBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="12,6"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding OcrHotkey}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsRecordingOcrHotkey}" Value="True">
                                                                        <Setter Property="Text" Value="请按组合键…" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <ui:Button Content="恢复默认"
                                                           Command="{Binding ResetOcrHotkeyCommand}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Visibility="{Binding IsRecordingOcrHotkey, Converter={StaticResource BoolToVis}}"
                                                           Margin="0,0,6,0"
                                                           ToolTip="填入 Ctrl+Shift+O，保存后生效" />
                                                <ui:Button Content="修改"
                                                           Command="{Binding RecordOcrHotkeyCommand}"
                                                           Style="{StaticResource SecondaryActionButton}"
                                                           Visibility="{Binding IsRecordingOcrHotkey, Converter={StaticResource InverseBoolToVis}}"
                                                           VerticalAlignment="Center" />
                                                <ui:Button Content="取消"
                                                           Command="{Binding CancelOcrHotkeyRecordingCommand}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Visibility="{Binding IsRecordingOcrHotkey, Converter={StaticResource BoolToVis}}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </ui:CardControl>

                                        <TextBlock Text="系统启动" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Power24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="登录 Windows 时自动启动" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding StartupStatus}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Content="系统启动设置"
                                                           Command="{Binding OpenWindowsStartupSettingsCommand}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Margin="0,0,10,0" />
                                                <ui:ToggleSwitch x:Name="StartWithWindowsSwitch"
                                                                 IsChecked="{Binding StartWithWindows}"
                                                                 IsEnabled="{Binding CanChangeStartup}"
                                                                 AutomationProperties.Name="登录 Windows 时自动启动" />
                                            </StackPanel>
                                        </ui:CardControl>

                                        <Border Visibility="{Binding StartupPathNeedsRepair, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource WarningSurfaceBrush}"
                                                BorderBrush="{DynamicResource WarningBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,10"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:CrispSymbolIcon Symbol="Warning20" FontSize="18" Foreground="{DynamicResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="检测到当前开机启动项路径与程序位置不一致，建议立即修复。"
                                                           Foreground="{DynamicResource WarningTextBrush}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <ui:Button x:Name="StartupRepairButton" Grid.Column="2" Content="修复启动路径"
                                                           Command="{Binding RepairStartupPathCommand}"
                                                           IsEnabled="{Binding CanChangeStartup}"
                                                           Visibility="{Binding StartupPathNeedsRepair, Converter={StaticResource BoolToVis}}"
                                                           Style="{StaticResource SecondaryActionButton}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="划词与浮标" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Cursor24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="鼠标划词取词" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="拖选或双击支持无障碍接口的文本后触发取词（不自动复制剪贴板）" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding MouseSelectionEnabled, Mode=TwoWay}"
                                                             AutomationProperties.Name="鼠标划词取词" />
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Flash24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="划词触发方式" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="「检测到英语时自动翻译」会跳过浮标直接显示译文，其他语言仍显示浮标" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox x:Name="MouseSelectionTriggerModeBox" MinWidth="210" MinHeight="34" VerticalAlignment="Center"
                                                      SelectedValue="{Binding MouseSelectionTriggerMode, Mode=TwoWay}" SelectedValuePath="Tag"
                                                      IsEnabled="{Binding MouseSelectionEnabled}" AutomationProperties.Name="划词触发方式">
                                                <ComboBoxItem Content="显示查词浮标（点击再翻译）" Tag="{x:Static models:MouseSelectionSettings.Pill}" />
                                                <ComboBoxItem Content="检测到英语时自动翻译" Tag="{x:Static models:MouseSelectionSettings.AutoEnglish}" />
                                                <ComboBoxItem Content="划词后直接自动翻译" Tag="{x:Static models:MouseSelectionSettings.AutoAll}" />
                                            </ComboBox>
                                        </ui:CardControl>

                                        <ui:CardControl x:Name="MouseSelectionHoverCard" Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Open24}"
                                                        IsEnabled="{Binding MouseSelectionEnabled}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="悬停浮标自动展开" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="鼠标停留在查词浮标约 300 毫秒后直接弹出迷你卡片，无需点击" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding MouseSelectionHoverToShowMini, Mode=TwoWay}"
                                                             AutomationProperties.Name="悬停浮标自动展开" />
                                        </ui:CardControl>

                                        <ui:CardControl x:Name="MouseSelectionBlacklistCard" Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Prohibited24}"
                                                        IsEnabled="{Binding MouseSelectionEnabled}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="禁用划词的应用" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="填写进程名（支持逗号或换行分隔，可省略 .exe），在这些应用内禁用鼠标划词取词" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:TextBox MinWidth="240" MaxWidth="320"
                                                        Text="{Binding MouseSelectionBlacklistText, UpdateSourceTrigger=PropertyChanged}"
                                                        PlaceholderText="WindowsTerminal, cmd, pwsh"
                                                        AutomationProperties.Name="禁用划词的应用" />
                                        </ui:CardControl>
                                    </StackPanel>
                                </TabItem>

                                <!-- Category 2: 查词与词典 -->
                                <TabItem x:Name="LookupSettingsCategory" Header="查词与词典">
                                    <StackPanel x:Name="LookupSettingsGroup">
                                        <TextBlock Text="翻译引擎与语言" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="2,0,0,8" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Translate24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="在线快译服务" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="离线词典未收录时优先使用所选服务，不可用时自动切换其他引擎" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="210" MinHeight="34" VerticalAlignment="Center"
                                                      SelectedValue="{Binding MachineTranslationProvider, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag"
                                                      AutomationProperties.Name="在线快译">
                                                <ComboBoxItem Content="微软翻译" Tag="microsoft" />
                                                <ComboBoxItem Content="谷歌翻译" Tag="google" />
                                                <ComboBoxItem Content="B站 Index-Translate" Tag="bilibili" />
                                            </ComboBox>
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Globe24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="目标语言" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="在线快译和 AI 详解的输出语言，如简体中文、English 或 zh-CN" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:TextBox MinWidth="180"
                                                        Text="{Binding ExplainLanguage, UpdateSourceTrigger=LostFocus}"
                                                        PlaceholderText="简体中文" />
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon ArrowSwap24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="中英自动互译" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="选中中文时自动译为英文，其他语言仍按目标语言输出" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch x:Name="AutoBidirectionalTranslationSwitch" IsChecked="{Binding AutoBidirectionalTranslation, Mode=TwoWay}"
                                                             AutomationProperties.Name="中英自动互译" />
                                        </ui:CardControl>

                                        <TextBlock Text="朗读与发音" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Speaker224}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="发音口音" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="选择美式、英式或跟随系统默认语音" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ComboBox MinWidth="148" MinHeight="34" VerticalAlignment="Center"
                                                      SelectedValue="{Binding SpeechAccent, Mode=TwoWay}" SelectedValuePath="Tag"
                                                      AutomationProperties.Name="发音口音">
                                                <ComboBoxItem Content="美式英语" Tag="{x:Static models:SpeechSettings.AccentUs}" />
                                                <ComboBoxItem Content="英式英语" Tag="{x:Static models:SpeechSettings.AccentGb}" />
                                                <ComboBoxItem Content="跟随系统" Tag="{x:Static models:SpeechSettings.AccentAuto}" />
                                            </ComboBox>
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Cloud24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="在线真人发音" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="英文词条优先播放在线真人语音（开启后会将朗读文本发送至有道语音），离线或超时自动回退系统朗读" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding SpeechUseOnlineVoice, Mode=TwoWay}"
                                                             AutomationProperties.Name="在线真人发音" />
                                        </ui:CardControl>

                                        <TextBlock Text="离线词典管理" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Library24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="离线英汉词典" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <WrapPanel Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding DictStatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding DictionaryCountText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:Button Content="{Binding DictionaryDownloadText}"
                                                       Command="{Binding InstallDictFromUrlCommand}"
                                                       IsEnabled="{Binding IsDictInstalling, Converter={StaticResource InverseBool}}">
                                                <ui:Button.Style>
                                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryActionButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DictInstalled}" Value="False">
                                                                <Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
                                                                <Setter Property="MouseOverBackground" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                                                                <Setter Property="PressedBackground" Value="{DynamicResource AccentButtonBackgroundPressed}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                            </ui:Button>
                                        </ui:CardControl>

                                        <Border Visibility="{Binding IsDictInstalling, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource SurfaceCardStyle}" Padding="16,12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <ProgressBar Value="{Binding DictProgressValue}" IsIndeterminate="{Binding IsDictProgressIndeterminate}" Height="4" Maximum="100" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DictProgressText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <ui:Button Grid.Column="1" Content="取消安装" Command="{Binding CancelDictionaryInstallCommand}" Style="{StaticResource QuietActionButton}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <ui:InfoBar Style="{StaticResource FluentInfoBarStyle}"
                                                    Severity="Informational"
                                                    IsOpen="True"
                                                    Title="词典状态"
                                                    Message="{Binding DictFeedback}"
                                                    Visibility="{Binding DictFeedback, Converter={StaticResource StringToVis}}" />

                                        <ui:CardExpander x:Name="DictionaryManagementExpander"
                                                         Style="{StaticResource FluentSettingsExpanderStyle}"
                                                         Icon="{controls:CrispIcon FolderOpen24}">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="词典源地址与本地文件" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding DictDetailsText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel>
                                                <TextBlock Text="词典下载地址" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                <ui:TextBox Text="{Binding DictDownloadUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                                                <WrapPanel>
                                                    <ui:Button Content="从本地文件安装"
                                                               Style="{StaticResource SecondaryActionButton}"
                                                               Command="{Binding InstallDictFromFileCommand}"
                                                               IsEnabled="{Binding IsDictInstalling, Converter={StaticResource InverseBool}}"
                                                               Margin="0,0,8,0" />
                                                    <ui:Button Content="删除离线词典"
                                                               Style="{StaticResource DangerActionButton}"
                                                               Command="{Binding RemoveDictCommand}"
                                                               IsEnabled="{Binding IsDictInstalling, Converter={StaticResource InverseBool}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </ui:CardExpander>

                                        <ui:CardExpander Style="{StaticResource FluentSettingsExpanderStyle}"
                                                         Icon="{controls:CrispIcon DocumentText24}">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="词典来源与许可声明" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="ahpxex/open-dictionary · English Wiktionary · CC BY-SA 4.0" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <TextBlock FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18">
                                                <Bold>数据署名与许可声明：</Bold><LineBreak />
                                                离线词典基于 <Run Text="ahpxex/open-dictionary" FontWeight="SemiBold" /> 项目发行文件，数据源自 English Wiktionary 及贡献者与 Wiktextract 项目，遵循 CC BY-SA 4.0 知识共享许可协议。本桌面应用代码与词典数据独立授权。
                                            </TextBlock>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </TabItem>

                                <!-- Category 3: AI 详解 -->
                                <TabItem x:Name="AiSettingsCategory" Header="AI 详解">
                                    <StackPanel x:Name="AiSettingsGroup">
                                        <TextBlock Text="配置方案与预设" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="2,0,0,8" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Sparkle24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="当前 AI 配置" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="填写服务地址、模型与 API Key 后可先测试连接，再点击底部「保存设置」" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ComboBox Width="168" MinHeight="34"
                                                          ItemsSource="{Binding AiProfiles}"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="Id"
                                                          SelectedValue="{Binding ActiveAiProfileId, UpdateSourceTrigger=PropertyChanged}"
                                                          Margin="0,0,8,0"
                                                          AutomationProperties.Name="AI 配置" />
                                                <ui:Button Content="新增"
                                                           Command="{Binding AddAiProfileCommand}"
                                                           Style="{StaticResource SecondaryActionButton}"
                                                           Margin="0,0,6,0" />
                                                <ui:Button Content="删除"
                                                           Command="{Binding RemoveAiProfileCommand}"
                                                           Style="{StaticResource DangerActionButton}" />
                                            </StackPanel>
                                        </ui:CardControl>

                                        <Border Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="16,13"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:CrispSymbolIcon Symbol="Apps24" FontSize="20"
                                                               Foreground="{DynamicResource CardForeground}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,16,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="服务商预设" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="一键填充 OpenAI 兼容接口地址和默认模型" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                                                    <ui:Button Content="OpenAI" Command="{Binding ApplyAiPresetCommand}" CommandParameter="openai" Style="{StaticResource SecondaryActionButton}" MinHeight="30" Padding="10,4" Margin="0,2,6,2" />
                                                    <ui:Button Content="DeepSeek" Command="{Binding ApplyAiPresetCommand}" CommandParameter="deepseek" Style="{StaticResource SecondaryActionButton}" MinHeight="30" Padding="10,4" Margin="0,2,6,2" />
                                                    <ui:Button Content="Kimi" Command="{Binding ApplyAiPresetCommand}" CommandParameter="kimi" Style="{StaticResource SecondaryActionButton}" MinHeight="30" Padding="10,4" Margin="0,2,6,2" />
                                                    <ui:Button Content="智谱 GLM" Command="{Binding ApplyAiPresetCommand}" CommandParameter="zhipu" Style="{StaticResource SecondaryActionButton}" MinHeight="30" Padding="10,4" Margin="0,2,6,2" />
                                                    <ui:Button Content="硅基流动" Command="{Binding ApplyAiPresetCommand}" CommandParameter="siliconflow" Style="{StaticResource SecondaryActionButton}" MinHeight="30" Padding="10,4" Margin="0,2,6,2" />
                                                    <ui:Button Content="本地 Ollama" Command="{Binding ApplyAiPresetCommand}" CommandParameter="ollama" Style="{StaticResource SecondaryActionButton}" MinHeight="30" Padding="10,4" Margin="0,2,0,2" />
                                                </WrapPanel>
                                            </Grid>
                                        </Border>

                                        <TextBlock Text="接口与密钥" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardExpander Style="{StaticResource FluentSettingsExpanderStyle}"
                                                         IsExpanded="True"
                                                         Icon="{controls:CrispIcon Key24}">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="服务地址与密钥" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="密钥仅用于当前 AI 配置，通过系统 DPAPI 本地加密保存" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="配置名称" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding AiProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="接口地址" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="模型名称" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding ApiModel, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="API Key" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:PasswordBox x:Name="ApiKeyBox" Grid.Column="1"
                                                                    PasswordChanged="ApiKeyBox_PasswordChanged"
                                                                    ToolTip="密钥仅用于当前 AI 配置，本地加密保存"
                                                                    AutomationProperties.Name="API Key" />
                                                </Grid>
                                                <ui:Button Style="{StaticResource SecondaryActionButton}"
                                                           IsEnabled="{Binding IsTestingAi, Converter={StaticResource InverseBool}}"
                                                           Command="{Binding TestAiConnectionCommand}"
                                                           HorizontalAlignment="Left"
                                                           Margin="140,0,0,0">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="测试 AI 连接" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTestingAi}" Value="True">
                                                                        <Setter Property="Text" Value="正在测试…" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ui:Button>
                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </TabItem>

                                <!-- Category 4: 同步与联动 -->
                                <TabItem x:Name="SyncSettingsCategory" Header="同步与联动">
                                    <StackPanel>
                                        <TextBlock Text="WebDAV 云端词库同步" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="2,0,0,8" />
                                        <ui:InfoBar Style="{StaticResource FluentInfoBarStyle}"
                                                    Severity="Informational"
                                                    IsOpen="True"
                                                    Title="WebDAV 服务器要求"
                                                    Message="在桌面端和浏览器扩展中填写相同的 WebDAV 地址与文件路径即可双向同步；地址须使用 HTTPS，服务器需支持强 ETag 与条件写入以避免覆盖冲突。" />

                                        <ui:CardControl x:Name="WebDavSettingsGroup" Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon CloudSwap24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="启用 WebDAV 词库同步" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="开启后可手动或自动与云端生词库合并同步" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding WebDavEnabled}"
                                                             AutomationProperties.Name="启用 WebDAV 词库同步"
                                                             ToolTip="启用 WebDAV 多端生词库同步" />
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon ArrowSync24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="词库修改后自动同步" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="新增、编辑或删除词条后自动与云端合并同步" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding WebDavAutoSync}"
                                                             AutomationProperties.Name="词库修改后自动同步"
                                                             ToolTip="新增、编辑或删除词条后自动与云端合并同步" />
                                        </ui:CardControl>

                                        <ui:CardExpander Style="{StaticResource FluentSettingsExpanderStyle}"
                                                         IsExpanded="True"
                                                         Icon="{controls:CrispIcon PlugConnected24}">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="WebDAV 服务器连接配置" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="密码通过系统 DPAPI 在本地加密保存" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="WebDAV 地址" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding WebDavUrl, UpdateSourceTrigger=PropertyChanged}" ToolTip="例如 https://dav.jianguoyun.com/dav/" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="同步文件路径" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding WebDavRemotePath, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="账号" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="密码（或应用密码）" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:PasswordBox x:Name="WebDavPasswordBox" Grid.Column="1"
                                                                    PasswordChanged="WebDavPasswordBox_PasswordChanged"
                                                                    ToolTip="WebDAV 密码使用系统 DPAPI 在本地加密保存"
                                                                    AutomationProperties.Name="WebDAV 密码" />
                                                </Grid>
                                                <WrapPanel Margin="150,0,0,0">
                                                    <ui:Button Style="{StaticResource SecondaryActionButton}"
                                                               IsEnabled="{Binding IsTestingWebDav, Converter={StaticResource InverseBool}}"
                                                               Command="{Binding TestWebDavConnectionCommand}"
                                                               Margin="0,0,8,0">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="测试 WebDAV 连接" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTestingWebDav}" Value="True">
                                                                            <Setter Property="Text" Value="正在测试…" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource SecondaryActionButton}"
                                                               IsEnabled="{Binding IsSyncingWebDav, Converter={StaticResource InverseBool}}"
                                                               Command="{Binding SyncWebDavNowCommand}">
                                                        <TextBlock>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="立即同步词库" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSyncingWebDav}" Value="True">
                                                                            <Setter Property="Text" Value="正在同步…" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ui:Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ui:CardExpander>

                                        <TextBlock Text="Anki 联动制卡" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardControl x:Name="AnkiSettingsGroup" Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Flash24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="自动将收藏发送到 Anki" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="请先打开 Anki 并安装 AnkiConnect 插件" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:ToggleSwitch IsChecked="{Binding AnkiEnabled}"
                                                             AutomationProperties.Name="自动将收藏发送到 Anki"
                                                             ToolTip="自动将收藏发送到 Anki" />
                                        </ui:CardControl>

                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Book24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <TextBlock Text="牌组名称" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="收藏词条默认导入的目标 Anki 牌组" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:TextBox MinWidth="180" Text="{Binding AnkiDeckName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                                <ui:Button Style="{StaticResource SecondaryActionButton}"
                                                           IsEnabled="{Binding IsTestingAnki, Converter={StaticResource InverseBool}}"
                                                           Command="{Binding TestAnkiConnectionCommand}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="测试 Anki 连接" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTestingAnki}" Value="True">
                                                                        <Setter Property="Text" Value="正在测试…" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ui:Button>
                                            </StackPanel>
                                        </ui:CardControl>

                                        <ui:CardExpander Style="{StaticResource FluentSettingsExpanderStyle}" Icon="{controls:CrispIcon Apps24}">
                                            <ui:CardExpander.Header>
                                                <StackPanel>
                                                    <TextBlock Text="Anki 高级选项" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="自定义 AnkiConnect 地址、笔记类型与上下文挖空方式" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </ui:CardExpander.Header>
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="AnkiConnect 地址" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding AnkiUrl, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="笔记类型" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <ui:TextBox Grid.Column="1" Text="{Binding AnkiNoteTypeName, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                                <Grid MinHeight="32">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="在卡片中挖空目标词" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <TextBlock Text="将例句中的单词替换为填空形式" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AnkiClozeContext}"
                                                                     AutomationProperties.Name="在卡片中挖空目标词"
                                                                     ToolTip="将例句中的单词替换为填空"
                                                                     VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </ui:CardExpander>
                                    </StackPanel>
                                </TabItem>

                                <!-- Category 5: 关于与更新 -->
                                <TabItem x:Name="AboutSettingsCategory" Header="关于与更新">
                                    <StackPanel x:Name="AboutSettingsGroup">
                                        <TextBlock Text="应用信息与版本更新" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="2,0,0,8" />
                                        <ui:CardControl Style="{StaticResource FluentSettingsCardStyle}" Icon="{controls:CrispIcon Info24}">
                                            <ui:CardControl.Header>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Word Catcher" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="支持全局快捷键、鼠标划词与截屏 OCR 取词，结合离线词典、在线快译与 AI 详解理解词义并收藏到生词库。" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </ui:CardControl.Header>
                                            <ui:Button Content="检查更新"
                                                       Style="{StaticResource PrimaryActionButton}"
                                                       Command="{Binding CheckForUpdatesCommand}"
                                                       IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                                       ToolTip="检查 GitHub Releases 中是否有新版本" />
                                        </ui:CardControl>

                                        <Border Style="{StaticResource SurfaceCardStyle}" Padding="16,14" Margin="0,0,0,8"
                                                Visibility="{Binding HasCheckedForUpdates, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <ui:InfoBar Style="{StaticResource FluentInfoBarStyle}"
                                                            Severity="Informational"
                                                            IsOpen="True"
                                                            Title="更新状态"
                                                            Message="{Binding UpdateStatus}"
                                                            Margin="0" />
                                                <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4" Margin="0,10,0,4"
                                                             Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}" />
                                                <WrapPanel Margin="0,10,0,0">
                                                    <ui:Button Content="安装更新" Style="{StaticResource PrimaryActionButton}"
                                                               Command="{Binding InstallUpdateCommand}"
                                                               IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                                               Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                                    <ui:Button Content="取消" Style="{StaticResource QuietActionButton}"
                                                               Command="{Binding CheckForUpdatesCancelCommand}"
                                                               Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}" />
                                                </WrapPanel>
                                                <TextBlock Text="更新检查与下载仅访问 GitHub 发布信息和安装包，不会上传词库、API Key 或取词内容。"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="{StaticResource CaptionFontSize}"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="相关链接" Style="{StaticResource SettingsGroupHeaderStyle}" />
                                        <ui:CardAction Style="{StaticResource FluentSettingsActionStyle}"
                                                       Icon="{controls:CrispIcon Code24}"
                                                       Command="{Binding OpenProjectPageCommand}"
                                                       ToolTip="在浏览器中打开项目主页">
                                            <StackPanel>
                                                <TextBlock Text="GitHub 项目主页" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="查看源码实现、版本日志与文档说明" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </ui:CardAction>

                                        <ui:CardAction Style="{StaticResource FluentSettingsActionStyle}"
                                                       Icon="{controls:CrispIcon ArrowDownload24}"
                                                       Command="{Binding OpenLatestReleasePageCommand}"
                                                       ToolTip="在浏览器中打开最新 GitHub Release">
                                            <StackPanel>
                                                <TextBlock Text="GitHub Releases 下载页面" FontSize="13.5" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="手动下载最新安装包或查看发布说明" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </ui:CardAction>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <ui:InfoBar Style="{StaticResource FluentInfoBarStyle}"
                                    Severity="Informational"
                                    IsOpen="True"
                                    Margin="0,8,0,0"
                                    Title="提示"
                                    Message="{Binding StatusMessage}"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                        <Border x:Name="SettingsPendingBar"
                                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource SurfaceCardStyle}"
                                Padding="16,12"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding DraftStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                                    <TextBlock Text="保存后生效；切换标签页也会保留草稿" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="DiscardSettingsButton" Content="放弃修改" Command="{Binding DiscardChangesCommand}"
                                               Style="{StaticResource QuietActionButton}" Margin="0,0,8,0"
                                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}"
                                               IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" />
                                    <ui:Button x:Name="SettingsSaveButton" Style="{StaticResource PrimaryActionButton}"
                                               ToolTip="保存设置（Ctrl+S）；切换页面会保留未保存的修改"
                                               Command="{Binding SaveSettingsCommand}"
                                               IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}"
                                               Padding="18,8">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="保存设置" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Text" Value="正在保存…" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
            </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
