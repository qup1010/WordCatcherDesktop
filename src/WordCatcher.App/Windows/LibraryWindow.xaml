                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="同步文件路径" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding WebDavRemotePath, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" Padding="10,6" FontSize="13"
                                             Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="账号" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding WebDavUsername, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" Padding="10,6" FontSize="13"
                                             Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="密码（或应用密码）" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ui:PasswordBox x:Name="WebDavPasswordBox" Grid.Column="1"
                                                    PasswordChanged="WebDavPasswordBox_PasswordChanged"
                                                    MinHeight="36" Padding="10,6" FontSize="13"
                                                    Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                    VerticalContentAlignment="Center"
                                                    ToolTip="WebDAV 密码使用系统 DPAPI 在本地加密保存" AutomationProperties.Name="WebDAV 密码" />
                                </Grid>

                                <Grid MinHeight="44" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="词库修改后自动同步" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <CheckBox Grid.Column="1" Width="36" IsChecked="{Binding WebDavAutoSync}" Style="{StaticResource SettingsSwitchCheckBoxStyle}" AutomationProperties.Name="词库修改后自动同步" ToolTip="新增、编辑或删除词条后自动与云端合并同步" VerticalAlignment="Center" />
                                </Grid>

                                <WrapPanel Margin="160,4,0,0">
                                    <ui:Button Style="{StaticResource SecondaryActionButton}"
                                            IsEnabled="{Binding IsTestingWebDav, Converter={StaticResource InverseBool}}"
                                            Command="{Binding TestWebDavConnectionCommand}"
                                            Padding="12,5"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="测试 WebDAV 连接" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTestingWebDav}" Value="True">
                                                            <Setter Property="Text" Value="正在测试…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ui:Button>
                                    <ui:Button Style="{StaticResource SecondaryActionButton}"
                                            IsEnabled="{Binding IsSyncingWebDav, Converter={StaticResource InverseBool}}"
                                            Command="{Binding SyncWebDavNowCommand}"
                                            Padding="12,5"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="立即同步词库" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSyncingWebDav}" Value="True">
                                                            <Setter Property="Text" Value="正在同步…" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
<GroupBox x:Name="AnkiSettingsGroup" Header="Anki" Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <TextBlock Text="开启后，收藏的词条会自动发送到 Anki。请先打开 Anki 并安装 AnkiConnect 插件。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Grid MinHeight="44" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="自动将收藏发送到 Anki" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <CheckBox Grid.Column="1" Width="36" IsChecked="{Binding AnkiEnabled}" Style="{StaticResource SettingsSwitchCheckBoxStyle}" AutomationProperties.Name="自动将收藏发送到 Anki" ToolTip="自动将收藏发送到 Anki" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="牌组名称" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding AnkiDeckName, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" Padding="10,6" FontSize="13"
                                             Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center" />
                                </Grid>

                                <ui:Button Style="{StaticResource SecondaryActionButton}" IsEnabled="{Binding IsTestingAnki, Converter={StaticResource InverseBool}}"
                                        Command="{Binding TestAnkiConnectionCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="12,5"
                                        Background="{StaticResource SubtleSurfaceBrush}"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0"
                                        Margin="160,4,0,0"
                                        Cursor="Hand" ><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="测试 Anki 连接" /><Style.Triggers><DataTrigger Binding="{Binding IsTestingAnki}" Value="True"><Setter Property="Text" Value="正在测试…" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></ui:Button>
                            <Expander Header="Anki 高级选项" Margin="0,16,0,0"><StackPanel Margin="0,12,0,0"><Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AnkiConnect 地址" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding AnkiUrl, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" Padding="10,6" FontSize="13"
                                             Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center" />
                                </Grid><Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="笔记类型" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding AnkiNoteTypeName, UpdateSourceTrigger=PropertyChanged}"
                                             MinHeight="36" Padding="10,6" FontSize="13"
                                             Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                             BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                             VerticalContentAlignment="Center" />
                                </Grid><Grid MinHeight="44" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="在卡片中挖空目标词" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <CheckBox Grid.Column="1" Width="36" IsChecked="{Binding AnkiClozeContext}" Style="{StaticResource SettingsSwitchCheckBoxStyle}" AutomationProperties.Name="在卡片中挖空目标词" ToolTip="将例句中的单词替换为填空" VerticalAlignment="Center" />
                                </Grid></StackPanel></Expander></StackPanel>
                        </GroupBox>
<GroupBox x:Name="InteractionSettingsGroup" Header="操作与显示" Style="{StaticResource SettingsSectionStyle}"><StackPanel>
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="收藏后关闭浮窗" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <CheckBox Grid.Column="1" Width="36" IsChecked="{Binding ClosePopupAfterSave}" Style="{StaticResource SettingsSwitchCheckBoxStyle}" AutomationProperties.Name="收藏后关闭浮窗" ToolTip="钉住的浮窗会保持打开" VerticalAlignment="Center" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderBrush}" />
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="点击外部关闭浮窗" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <CheckBox Grid.Column="1" Width="36" IsChecked="{Binding ClosePopupOnDeactivate}" Style="{StaticResource SettingsSwitchCheckBoxStyle}" AutomationProperties.Name="点击外部关闭浮窗" ToolTip="钉住的浮窗会保持打开" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="钉住时保持打开。修改后自动保存。" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" Margin="0,6,0,0" />
                            <Grid Margin="0,20,0,0" MinHeight="40">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="取词快捷键" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="4" Padding="10,5" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Hotkey}" /><Style.Triggers><DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True"><Setter Property="Text" Value="请按组合键…" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Border>
                                    <ui:Button x:Name="RecordHotkeyButton" Grid.Column="2" Content="修改" Command="{Binding RecordHotkeyCommand}" Style="{StaticResource SecondaryActionButton}" Visibility="{Binding IsRecordingHotkey, Converter={StaticResource InverseBoolToVis}}" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="2" Content="取消" Command="{Binding CancelHotkeyRecordingCommand}" Style="{StaticResource QuietActionButton}" Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                                </Grid>
                                <WrapPanel Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0"><ui:Button Content="恢复默认" Command="{Binding ResetHotkeyCommand}" Style="{StaticResource QuietActionButton}" ToolTip="填入 Ctrl+Shift+Z，保存后生效" /></WrapPanel>
                                <TextBlock Text="{Binding HotkeyHint}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" LineHeight="19" Margin="0,6,0,0" />
                            </StackPanel></GroupBox>
<GroupBox x:Name="AboutSettingsGroup" Header="关于" Style="{StaticResource SettingsSectionStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Word Catcher" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="当前版本 " Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                            Content="检查更新" Style="{StaticResource SecondaryActionButton}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                            Background="{StaticResource AccentBrush}"
                                            Foreground="{StaticResource OnAccentBrush}"
                                            Padding="14,7"
                                            ToolTip="检查 GitHub Releases 中是否有新版本" />
                                </Grid>
                                <TextBlock Text="选中文字后按取词快捷键，即可查看释义，并将单词和原句收藏到生词库。"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           LineHeight="19"
                                           Margin="0,0,0,10" />
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,0,0,12"
                                        Visibility="{Binding HasCheckedForUpdates, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                                        <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="4" Margin="0,8,0,4"
                                                     Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <ui:Button Content="安装更新" Style="{StaticResource PrimaryActionButton}"
                                                       Command="{Binding InstallUpdateCommand}"
                                                       IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBool}}"
                                                       Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                            <ui:Button Content="取消" Style="{StaticResource QuietActionButton}"
                                                       Command="{Binding CheckForUpdatesCancelCommand}"
                                                       Visibility="{Binding IsCheckingForUpdates, Converter={StaticResource BoolToVis}}" />
                                        </WrapPanel>
                                        <TextBlock Text="更新检查与下载访问 GitHub 发布信息和安装包，不会上传词库、API Key 或取词内容。"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="{StaticResource CaptionFontSize}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <WrapPanel>
                                    <ui:Button Content="打开项目主页" Style="{StaticResource QuietActionButton}"
                                            Command="{Binding OpenProjectPageCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            ToolTip="在浏览器中打开项目主页" />
                                    <ui:Button Content="打开下载页面" Style="{StaticResource QuietActionButton}"
                                            Command="{Binding OpenLatestReleasePageCommand}"
                                            Padding="12,6"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            ToolTip="在浏览器中打开最新 GitHub Release" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding StatusMessage}" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" Margin="14,8,14,0" />
                <Border x:Name="SettingsPendingBar" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,12" Margin="0,10,0,0" CornerRadius="8">
                <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
<TextBlock Text="{Binding DraftStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
<TextBlock Text="保存后生效" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="DiscardSettingsButton" Content="放弃修改" Command="{Binding DiscardChangesCommand}" Style="{StaticResource QuietActionButton}" Margin="0,0,8,0" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" />
                        <ui:Button x:Name="SettingsSaveButton" Style="{StaticResource PrimaryActionButton}" ToolTip="保存设置（Ctrl+S）；切换页面会保留未保存的修改" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" Padding="18,9">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="保存设置" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaving}" Value="True"><Setter Property="Text" Value="正在保存…" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
                </Grid>
            </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
