<Window x:Class="WordCatcher.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
        xmlns:views="clr-namespace:WordCatcher.App.Views"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:WordCatcher.App.Converters"
        xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Word Catcher 桌面伴侣"
        Icon="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.ico"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{DynamicResource UiFontFamily}"
        Background="{DynamicResource CanvasBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/WordCatcher.App;component/Themes/DesignSystem.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:SyncStatusLabelConverter x:Key="SyncStatusLabel" />
        <converters:LocalDateTimeConverter x:Key="LocalTime" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="WindowCaptionButton" TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle"><Setter.Value><Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border Margin="4" BorderBrush="#5C554B" BorderThickness="1" CornerRadius="3" /></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource WindowCaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F7F6F2" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Height="40">
                            <Border x:Name="TabBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="5" />
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    Visibility="Collapsed" />
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource SelectedSurfaceBrush}" />
                                <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkspaceSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="Divider"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BorderBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Divider" Property="Width" Value="2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Divider" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageHostTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <ItemsPresenter Grid.Row="0" Visibility="Collapsed" />
                            <Border Grid.Row="1" Background="{StaticResource CanvasBrush}">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                  Margin="24,20,24,22" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSectionStyle" TargetType="GroupBox">
            <Setter Property="Padding" Value="0,0,0,18" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Padding="{TemplateBinding Padding}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  Margin="0,0,0,12"
                                                  TextElement.FontSize="{StaticResource BodyFontSize}"
                                                  TextElement.FontWeight="Medium"
                                                  TextElement.Foreground="{StaticResource TextPrimaryBrush}" />
                                <ContentPresenter Grid.Row="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsSwitchCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="SwitchRoot" MinHeight="26" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack" Width="36" Height="20"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{StaticResource SubtleSurfaceBrush}"
                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="10">
                                <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Margin="2"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Fill="{StaticResource TextSecondaryBrush}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource SelectedSurfaceBrush}" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource TextPrimaryBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchRoot" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.Row="0" Panel.ZIndex="10" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BrandColumn" Width="208" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                           Width="22" Height="22" Stretch="Uniform" />
                    <TextBlock x:Name="BrandText" Text="Word Catcher" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel x:Name="CaptionButtonsPanel" Grid.Column="2" Panel.ZIndex="20" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <ui:Button x:Name="MinimizeButton" Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeButton_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </ui:Button>
                    <ui:Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButton}"
                            Click="MaximizeButton_Click" ToolTip="最大化" AutomationProperties.Name="最大化">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </ui:Button>
                    <ui:Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}"
                            Click="CloseButton_Click" ToolTip="关闭到托盘" AutomationProperties.Name="关闭到托盘">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SubtleSurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:NavigationView x:Name="AppNavigation"
                                       PaneDisplayMode="Left"
                                       IsPaneOpen="True"
                                       IsPaneToggleVisible="False"
                                       IsBackButtonVisible="Collapsed"
                                       HeaderVisibility="Collapsed"
                                       IsFooterSeparatorVisible="False"
                                       OpenPaneLength="208"
                                       CompactPaneLength="64"
                                       FrameMargin="0">
                        <ui:NavigationView.MenuItems>
                            <ui:NavigationViewItem x:Name="LibraryNavigationItem" ToolTip="生词库（Ctrl+1）" Content="生词库" Tag="Library"
                                                   Icon="{ui:SymbolIcon Book24}" IsActive="True"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                            <ui:NavigationViewItem x:Name="LookupNavigationItem" ToolTip="查词（Ctrl+2）" Content="查词" Tag="Lookup"
                                                   Icon="{ui:SymbolIcon Search24}"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                            <ui:NavigationViewItem x:Name="SyncNavigationItem" ToolTip="WebDAV 与 Anki 同步（Ctrl+3）" Content="同步状态" Tag="Sync"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                            <ui:NavigationViewItem x:Name="SettingsNavigationItem" ToolTip="设置（Ctrl+4）" Content="设置" Tag="Settings"
                                                   Icon="{ui:SymbolIcon Settings24}"
                                                   Height="40" Margin="8,2" FontSize="13"
                                                   Click="NavigationItem_Click" />
                        </ui:NavigationView.MenuItems>
                    </ui:NavigationView>

                    <Border x:Name="NavigationHint" Grid.Row="1" Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Margin="12,12,12,16" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="快速取词" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" />
                            <Border Background="{StaticResource SubtleSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="4" HorizontalAlignment="Left" Margin="0,5,0,0" Padding="7,2">
                                <TextBlock Text="{Binding AppliedHotkey}" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Column="1"
                        Style="{StaticResource PageHostTabControl}">

            <!-- ================= TAB 1: 词库 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="LibraryTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="生词库" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="生词库" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="查看收藏的单词、释义和原句"
                                       Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button x:Name="StartReviewButton" Command="{Binding StartReviewCommand}" ToolTip="对当前列表中的词条与语境进行卡片自测复习"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    Background="{StaticResource AccentSubtleBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontSize="{StaticResource CaptionFontSize}"
                                    Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="卡片复习" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="SyncWebDavButton" Command="{Binding SyncWebDavCommand}" ToolTip="与 WebDAV 云端合并同步词库"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="{StaticResource CaptionFontSize}"
                                    Cursor="Hand">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="IsEnabled" Value="{Binding IsSyncingWebDav, Converter={StaticResource InverseBool}}" />
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="云端同步" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSyncingWebDav}" Value="True">
                                                        <Setter Property="Text" Value="同步中…" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="ImportBackupButton" Command="{Binding ImportJsonCommand}" ToolTip="导入桌面端或浏览器插件导出的 JSON 词库备份"
                                    Margin="0,0,8,0"
                                    Padding="12,6"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="{StaticResource CaptionFontSize}"
                                    Cursor="Hand">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="IsEnabled" Value="{Binding IsExporting, Converter={StaticResource InverseBool}}" />
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="导入备份" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="ExportBackupButton" Command="{Binding ExportJsonCommand}" ToolTip="导出全部词条与语境，不受当前搜索和筛选影响"
                                    Margin="0,0,10,0"
                                    Padding="12,6"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="{StaticResource CaptionFontSize}"
                                    Cursor="Hand">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="MinHeight" Value="36" />
                                        <Setter Property="IsEnabled" Value="{Binding IsExporting, Converter={StaticResource InverseBool}}" />
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0" />
                                    <TextBlock Text="导出备份" />
                                </StackPanel>
                            </ui:Button>
                            <TextBlock Text="{Binding Words.Count, StringFormat={}{0} 个词条}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="{StaticResource CaptionFontSize}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                        <Grid x:Name="LibraryWorkspace">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Words.Count}" Value="0" />
                                                <Condition Binding="{Binding SourceFilter}" Value="" /><Condition Binding="{Binding SearchQuery}" Value="" /><Condition Binding="{Binding SelectedFilterIndex}" Value="0" /><Condition Binding="{Binding CanUndoDelete}" Value="False" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" /><Condition Binding="{Binding HasLoadError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LibraryListColumn" Width="300" MinWidth="250" />
                                <ColumnDefinition Width="9" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                        <GridSplitter Grid.Column="1"
                                      Width="9"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ResizeBehavior="PreviousAndNext"
                                      Style="{StaticResource WorkspaceSplitterStyle}"
                                      ToolTip="拖动调整列表与详情宽度" />
                        <!-- Left: Search & Word List -->
                        <Border Grid.Column="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Search Bar -->
                                <StackPanel Grid.Row="0"><Grid Grid.Row="0" Margin="0,0,0,10" IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}">
                                    <ui:TextBox x:Name="SearchBox"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="搜索单词、释义、备注或原句"
                                             ClearButtonEnabled="False"
                                             MinHeight="36"
                                             Padding="32,6,32,6"
                                             FontSize="13"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             Background="{StaticResource SurfaceBrush}"
                                             VerticalContentAlignment="Center"
                                             BorderBrush="{StaticResource ControlBorderBrush}"
                                             BorderThickness="1"
                                             ToolTip="输入即搜索；Ctrl+F 聚焦，Esc 清空搜索"
                                             KeyDown="SearchBox_KeyDown" />
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="11,0,0,0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <ui:Button Command="{Binding ClearSearchCommand}"
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Visibility="{Binding SearchQuery, Converter={StaticResource StringToVis}}"
                                            ToolTip="清空搜索">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="{StaticResource CaptionFontSize}" />
                                    </ui:Button>
                                </Grid>
                                    <Grid Margin="0,0,0,8" IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding ResultCountText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultCountText}" />
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedSortIndex}" Width="112" MinHeight="28" Padding="6,2" FontSize="12" Margin="6,0" AutomationProperties.Name="词条排序">
                                            <ComboBoxItem Content="最近更新" /><ComboBoxItem Content="单词 A–Z" /><ComboBoxItem Content="最近收藏" />
                                        </ComboBox>
                                        <ToggleButton x:Name="LibraryFilterButton" Grid.Column="2" Content="{Binding FilterButtonText}" Padding="8,4" MinHeight="28" FontSize="12" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" ToolTip="按状态和来源应用筛选" />
                                        <Popup IsOpen="{Binding IsChecked, ElementName=LibraryFilterButton, Mode=TwoWay}" PlacementTarget="{Binding ElementName=LibraryFilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="290" Margin="0,4,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="筛选词条" FontWeight="Medium" Margin="0,0,0,12" />
                                                    <TextBlock Text="词条状态" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                    <ComboBox SelectedIndex="{Binding SelectedFilterIndex}" MinHeight="34" Margin="0,0,0,12" AutomationProperties.Name="按同步状态筛选生词">
                                                        <ComboBoxItem Content="全部词条" /><ComboBoxItem Content="待同步" /><ComboBoxItem Content="同步失败" /><ComboBoxItem Content="最近 7 天收藏" /><ComboBoxItem Content="有备注" /><ComboBoxItem Content="无备注" />
                                                    </ComboBox>
                                                    <TextBlock Text="来源应用" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                    <ui:TextBox Text="{Binding SourceFilter, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="如 chrome、WeChat" MinHeight="34" AutomationProperties.Name="按来源应用过滤" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <WrapPanel>
                                        <ui:Button Content="{Binding FilterTagText}" Command="{Binding ClearStatusFilterCommand}" Visibility="{Binding FilterTagText, Converter={StaticResource StringToVis}}" Style="{StaticResource QuietActionButton}" Padding="8,3" FontSize="12" Margin="0,0,6,8" ToolTip="移除词条状态筛选" />
                                        <ui:Button Content="{Binding SourceTagText}" Command="{Binding ClearSourceFilterCommand}" Visibility="{Binding SourceTagText, Converter={StaticResource StringToVis}}" Style="{StaticResource QuietActionButton}" Padding="8,3" FontSize="12" Margin="0,0,0,8" MaxWidth="200" ToolTip="移除来源应用筛选" />
                                    </WrapPanel>
</StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                    <WrapPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding BatchSelectionText}" VerticalAlignment="Center" FontSize="11" Margin="0,0,8,0" />
                                        <ui:Button Content="删除所选" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource QuietActionButton}" Padding="8,4" />
                                    </WrapPanel>
                                    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                                    <WrapPanel>
                                        <CheckBox Content="紧凑列表" IsChecked="{Binding IsCompact}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <CheckBox Content="遮挡释义" IsChecked="{Binding IsDefinitionMasked}" VerticalAlignment="Center" ToolTip="在列表与详情中先隐藏中文释义，方便主动回忆" />
                                    </WrapPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="{Binding StatusMessage, Converter={StaticResource StringToVis}}" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <WrapPanel Margin="0,5,0,0" Visibility="{Binding ShowContextSentenceActions, Converter={StaticResource BoolToVis}}">
                                            <ui:Button Content="{Binding ContextSentenceButtonText}" Command="{Binding RetryContextSentenceCommand}"
                                                       Style="{StaticResource QuietActionButton}" Padding="8,4" Margin="0,0,6,0" />
                                            <ui:Button Content="改用 AI" Command="{Binding UseAiFailedContextSentenceCommand}"
                                                       Visibility="{Binding CanUseAiContextSentence, Converter={StaticResource BoolToVis}}"
                                                       Style="{StaticResource QuietActionButton}" Padding="8,4" />
                                        </WrapPanel>
                                    </StackPanel><StackPanel Margin="0,8,0,0" Visibility="{Binding DeleteStatusText, Converter={StaticResource StringToVis}}">
<TextBlock Text="{Binding DeleteStatusText}" TextWrapping="Wrap" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}" />
<ui:Button Content="撤销删除" Style="{StaticResource SecondaryActionButton}" Command="{Binding UndoDeleteCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVis}}" />
</StackPanel>
                                    <ui:Button Content="重新加载" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
                                    <ui:Button Content="加载更多词条" Command="{Binding LoadMoreCommand}" Margin="0,8,0,0" IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- Words ListBox -->
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="WordList"
                                             SelectionMode="Extended"
                                             SelectionChanged="WordList_SelectionChanged"
                                             ItemsSource="{Binding Words}"
                                             IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBool}}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             SelectedItem="{Binding SelectedWord, Mode=TwoWay}"
                                             BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="FocusVisualStyle" Value="{x:Null}" /></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8,8"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <WrapPanel>
                                                            <TextBlock Text="{Binding DisplayWord}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="{StaticResource BodyFontSize}"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </WrapPanel>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding DefinitionSummary}"
                                                                   FontSize="{StaticResource CaptionFontSize}"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DataContext.IsDefinitionMasked, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.08" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" FontSize="28"
                                                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding EmptyMessage}" FontSize="{StaticResource BodyFontSize}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=WordList}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right: Word Detail & Occurrences / Edit View -->
                        <Border Grid.Column="2"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="0"
                                Padding="22">
                            <Grid>
                                <!-- No selection prompt -->
                                            <TextBlock Text="选择一个词条，查看释义与语境" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="{StaticResource BodyFontSize}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Selected Word View / Edit Area -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedWord}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Scrollable Main Content -->
                                    <ScrollViewer x:Name="DetailScroll" Grid.Row="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0,0,10,0">
                                        <StackPanel>
                                            <!-- In-App Flashcard Review Mode -->
                                            <Border Background="{StaticResource SubtleSurfaceBrush}"
                                                    BorderBrush="{StaticResource ControlBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="20,18"
                                                    Margin="0,0,0,18"
                                                    Visibility="{Binding IsReviewMode, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="4" Padding="8,3">
                                                                <TextBlock Text="语境自测复习" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding ReviewProgressText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <ui:Button Content="乱序" Command="{Binding ShuffleReviewCommand}" Style="{StaticResource QuietActionButton}" Padding="10,4" Margin="0,0,6,0" ToolTip="随机打乱复习顺序" />
                                                            <ui:Button Content="退出复习" Command="{Binding ExitReviewCommand}" Style="{StaticResource QuietActionButton}" Padding="10,4" ToolTip="退出复习模式（Esc）" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Front: Context Sentence Prompt -->
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                                        <StackPanel>
                                                            <TextBlock Text="请根据以下真实语境回忆词义与用法：" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                                                            <TextBlock Text="{Binding ReviewPromptSentence}" FontSize="16" FontWeight="Medium" LineHeight="25" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            <WrapPanel Margin="0,10,0,0">
                                                                <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                                        Visibility="{Binding CurrentReviewWord.PartOfSpeech, Converter={StaticResource StringToVis}}">
                                                                    <TextBlock Text="{Binding CurrentReviewWord.PartOfSpeech}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ReviewSourceSummary}" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                                                           Visibility="{Binding ReviewSourceSummary, Converter={StaticResource StringToVis}}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Back: Answer Area -->
                                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                                                            Visibility="{Binding IsAnswerRevealed, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,10">
                                                                <TextBlock Text="{Binding ReviewEffectiveExpression}" FontFamily="{StaticResource HeadwordFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                                <TextBlock Text="{Binding CurrentReviewWord.Reading}" FontFamily="{StaticResource PhoneticFontFamily}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                                           Visibility="{Binding CurrentReviewWord.Reading, Converter={StaticResource StringToVis}}" />
                                                                <ui:Button Command="{Binding SpeakWordCommand}" Style="{StaticResource QuietActionButton}" Padding="8,4" Margin="10,0,0,0" ToolTip="朗读（快捷键 P）">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                                                        <TextBlock Text="朗读" Margin="5,0,0,0" FontSize="{StaticResource CaptionFontSize}" />
                                                                    </StackPanel>
                                                                </ui:Button>
                                                            </WrapPanel>

                                                            <TextBlock Text="{Binding ReviewEffectiveDefinition}" FontSize="15" FontWeight="Medium" LineHeight="23" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ReviewEffectiveTranslation}" FontSize="13" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                       Visibility="{Binding ReviewEffectiveTranslation, Converter={StaticResource StringToVis}}" />

                                                            <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                                                                    Visibility="{Binding ReviewEffectiveKeyExplanation, Converter={StaticResource StringToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="语境解析" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                    <TextBlock Text="{Binding ReviewEffectiveKeyExplanation}" FontSize="13" LineHeight="20" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                                                                    Visibility="{Binding ReviewEffectiveNote, Converter={StaticResource StringToVis}}">
                                                                <StackPanel>
                                                                    <TextBlock Text="个人笔记" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                    <TextBlock Text="{Binding ReviewEffectiveNote}" FontSize="13" LineHeight="20" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Border>

                                                            <Border Background="{StaticResource AmberHookSurfaceBrush}" BorderBrush="{StaticResource AmberHookBorderBrush}" BorderThickness="3,0,0,0" CornerRadius="0,6,6,0" Padding="10,8" Margin="0,8,0,0"
                                                                    Visibility="{Binding CurrentReviewWord.MemoryHook, Converter={StaticResource StringToVis}}">
                                                                <TextBlock Foreground="{StaticResource AmberHookTextBrush}" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                                                                    <Run Text="记忆线索：" FontWeight="SemiBold" Foreground="{StaticResource AmberHookLabelBrush}" />
                                                                    <Run Text="{Binding CurrentReviewWord.MemoryHook}" />
                                                                </TextBlock>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Review Controls -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:Button Content="上一张 (←)" Command="{Binding PrevReviewCardCommand}" Style="{StaticResource SecondaryActionButton}" Padding="14,7" />
                                                        <ui:Button Grid.Column="1" Command="{Binding ToggleAnswerCommand}" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Center" Padding="24,7" Margin="12,0">
                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="显示答案 (Space)" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAnswerRevealed}" Value="True">
                                                                                <Setter Property="Text" Value="隐藏答案 (Space)" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </ui:Button>
                                                        <ui:Button Grid.Column="2" Content="下一张 (→)" Command="{Binding NextReviewCardCommand}" Style="{StaticResource SecondaryActionButton}" Padding="14,7" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Normal Display Mode -->
                                            <StackPanel x:Name="WordDetailsPanel">
                                                <StackPanel.Style><Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsReviewMode}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></StackPanel.Style>
                                                <!-- Header: Word, Reading, POS, Speak -->
                                                <WrapPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedWord.DisplayWord}"
                                                               FontFamily="{StaticResource HeadwordFontFamily}"
                                                               TextWrapping="Wrap" FontSize="28"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding SelectedWord.Reading}"
                                                               FontFamily="{StaticResource PhoneticFontFamily}"
                                                               FontSize="15"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center" />
                                                    <ui:Button Command="{Binding SpeakWordCommand}"
                                                               Style="{StaticResource QuietActionButton}"
                                                               Padding="8,4"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               ToolTip="朗读当前词条">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="朗读" FontSize="{StaticResource CaptionFontSize}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                    <Border Margin="10,0,0,0"
                                                            Background="{StaticResource AccentSubtleBrush}"
                                                            CornerRadius="4"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding SelectedWord.PartOfSpeech, Converter={StaticResource StringToVis}}">
                                                        <TextBlock Text="{Binding SelectedWord.PartOfSpeech}"
                                                                   FontSize="{StaticResource CaptionFontSize}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AccentBrush}" />
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Definition Text -->
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,18">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding WordDefinitionLabel}" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                                        <TextBlock Text="{Binding SelectedWord.Definition}" FontSize="{StaticResource BodyFontSize}" LineHeight="24" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDefinitionMasked}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.08" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Occurrence Records Card -->
                                                <Border Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0"
                                                        CornerRadius="8"
                                                        Padding="0"
                                                        Margin="0,16,0,8">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <TextBlock Text="{Binding SavedSentencesTitle}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />

                                                        </StackPanel>
                                                        <ListBox x:Name="OccurrenceList"
                                                                 ItemsSource="{Binding Occurrences}"
                                                                 BorderThickness="0"
                                                                 Background="Transparent"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Padding="14,12"
                                                                            Background="{StaticResource SurfaceBrush}"
                                                                            BorderBrush="{StaticResource BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            Margin="0,0,0,10">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding DefinitionLabel}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" Visibility="{Binding AdditionalDefinition, Converter={StaticResource StringToVis}}" />
                                                                            <TextBlock Text="{Binding AdditionalDefinition}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"
                                                                                       Visibility="{Binding AdditionalDefinition, Converter={StaticResource StringToVis}}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsDefinitionMasked, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                                <Setter Property="Opacity" Value="0.08" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding Sentence}" Margin="0,4,0,0"
                                                                                       TextWrapping="Wrap"
                                                                                       FontSize="14"
                                                                                       FontWeight="Medium"
                                                                                       LineHeight="22" Foreground="{StaticResource TextPrimaryBrush}" />

                                                                            <WrapPanel Margin="0,6,0,4" Visibility="{Binding SupplementaryExpression, Converter={StaticResource StringToVis}}">
                                                                                <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                    <TextBlock Text="核心表达" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Expression}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                            </WrapPanel>



                                                                            <TextBlock Text="{Binding Translation}"
                                                                                       FontSize="{StaticResource CaptionFontSize}"
                                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                                       TextWrapping="Wrap"
                                                                                       Margin="0,4,0,0"
                                                                                       LineHeight="19"
                                                                                       Visibility="{Binding Translation, Converter={StaticResource StringToVis}}">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding DataContext.IsDefinitionMasked, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                                <Setter Property="Opacity" Value="0.08" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <!-- Personal Note Highlighted Directly -->
                                                                            <Border Background="{StaticResource AccentSubtleBrush}" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                                                                                    Visibility="{Binding Note, Converter={StaticResource StringToVis}}">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="个人笔记" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                                    <TextBlock Text="{Binding Note}" FontSize="12.5" LineHeight="19" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <Expander Header="{Binding ExplanationLabel}" Visibility="{Binding HasExplanation, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                                                                <StackPanel Margin="0,6,0,0">
                                                                                    <StackPanel Visibility="{Binding KeyExplanation, Converter={StaticResource StringToVis}}" Margin="0,0,0,6">
                                                                                        <TextBlock Text="语境解析" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                                        <TextBlock Text="{Binding KeyExplanation}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Visibility="{Binding UsageNote, Converter={StaticResource StringToVis}}" Margin="0,0,0,6">
                                                                                        <TextBlock Text="用法提示" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                                        <TextBlock Text="{Binding UsageNote}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Visibility="{Binding Example, Converter={StaticResource StringToVis}}">
                                                                                        <TextBlock Text="拓展例句" FontSize="11" FontWeight="Medium" Foreground="{StaticResource AccentBrush}" />
                                                                                        <TextBlock Text="{Binding Example}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                                                                        <TextBlock Text="{Binding ExampleTranslation}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding ExampleTranslation, Converter={StaticResource StringToVis}}" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Expander>

                                                                            <Grid Margin="0,8,0,0">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="{StaticResource CaptionFontSize}"
                                                                                           Foreground="{StaticResource TextMutedBrush}"
                                                                                           VerticalAlignment="Center">
                                                                                    <Run Text="来源  " />
                                                                                    <Run Text="{Binding SourceProcess}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                                    <Run Text=" · " />
                                                                                    <Run Text="{Binding SourceWindowTitle}" />
                                                                                    <Run Text=" · " />
                                                                                    <Run Text="{Binding CapturedAtUtc, Converter={StaticResource LocalTime}}" />
                                                                                </TextBlock>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                                    <ui:Button Content="查看原文"
                                                                                               Command="{Binding DataContext.OpenSourceUriCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                               CommandParameter="{Binding SourceUri}"
                                                                                               Style="{StaticResource QuietActionButton}"
                                                                                               Padding="8,4"
                                                                                               Margin="0,0,6,0"
                                                                                               Visibility="{Binding SourceUri, Converter={StaticResource StringToVis}}" />
                                                                                    <ui:Button Content="翻译原句"
                                                                                               Command="{Binding DataContext.TranslateOccurrenceSentenceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                               CommandParameter="{Binding}"
                                                                                               Style="{StaticResource QuietActionButton}"
                                                                                               Padding="8,4"
                                                                                               Margin="0,0,6,0"
                                                                                               IsEnabled="{Binding DataContext.IsTranslatingContextSentence, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBool}}"
                                                                                               Visibility="{Binding Sentence, Converter={StaticResource StringToVis}}" />
                                                                                    <ui:Button Content="编辑语境"
                                                                                               Command="{Binding DataContext.EditContextCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                               CommandParameter="{Binding}"
                                                                                               Style="{StaticResource QuietActionButton}"
                                                                                               Padding="8,4" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <StackPanel Visibility="{Binding IsEditingContext, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                                            <TextBlock Text="语境释义" />
                                                            <ui:TextBox Text="{Binding ContextDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                                            <Grid>
                                                                <TextBlock Text="原句翻译" VerticalAlignment="Center" />
                                                                <WrapPanel HorizontalAlignment="Right">
                                                                <ui:Button Content="{Binding ContextSentenceButtonText}"
                                                                           Command="{Binding RetryContextSentenceCommand}"
                                                                           IsEnabled="{Binding IsTranslatingContextSentence, Converter={StaticResource InverseBool}}"
                                                                           Style="{StaticResource QuietActionButton}"
                                                                           Padding="6,2" />
                                                                <ui:Button Content="改用 AI"
                                                                           Command="{Binding UseAiOccurrenceSentenceCommand}"
                                                                           Visibility="{Binding CanUseAiContextSentence, Converter={StaticResource BoolToVis}}"
                                                                           IsEnabled="{Binding IsTranslatingContextSentence, Converter={StaticResource InverseBool}}"
                                                                           Style="{StaticResource QuietActionButton}"
                                                                           Padding="6,2" Margin="4,0,0,0" />
                                                                </WrapPanel>
                                                            </Grid>
                                                            <ui:TextBox Text="{Binding ContextTranslation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                                            <TextBlock Text="个人笔记" />
                                                            <ui:TextBox Text="{Binding ContextNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                                            <WrapPanel>
                                                                <ui:Button Content="保存语境" Command="{Binding SaveContextEditCommand}" Style="{StaticResource PrimaryActionButton}" />
                                                                <ui:Button Content="取消" Command="{Binding CancelContextEditCommand}" Style="{StaticResource SecondaryActionButton}" Margin="8,0,0,0" />
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,16,0,12">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding ElementName=OccurrenceList, Path=HasItems}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="暂无语境记录"
                                                                       FontWeight="Medium"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center" />
                                                            <TextBlock Text="屏幕取词时会尝试记录原句与来源。"
                                                                       FontSize="{StaticResource CaptionFontSize}"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Expander Header="记忆线索" Visibility="{Binding SelectedWord.MemoryHook, Converter={StaticResource StringToVis}}" Margin="0,12,0,0">
                                                <!-- Memory Hook (Amber Callout matching Extension & Anki) -->
                                                <Border Background="{StaticResource AmberHookSurfaceBrush}"
                                                        BorderBrush="{StaticResource AmberHookBorderBrush}"
                                                        BorderThickness="3,0,0,0"
                                                        CornerRadius="0,8,8,0"
                                                        Padding="12,10"
                                                        Margin="0,0,0,16"
                                                        Visibility="{Binding SelectedWord.MemoryHook, Converter={StaticResource StringToVis}}">
                                                    <TextBlock Foreground="{StaticResource AmberHookTextBrush}" FontSize="13" LineHeight="20" TextWrapping="Wrap">
                                                        <Run Text="记忆线索：" FontWeight="SemiBold" Foreground="{StaticResource AmberHookLabelBrush}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding SelectedWord.MemoryHook}" />
                                                    </TextBlock>
                                                </Border>

                                                </Expander>
                                            </StackPanel>

                                            <!-- Edit Mode Form -->
                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBool}}">
                                                <TextBlock Text="编辑词条" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                                <TextBlock Text="单词 / 原形" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="EditWordBox" Text="{Binding EditWordText, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                                         BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="音标" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditReading, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                                         BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="词性" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditPartOfSpeech, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                                         BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="释义" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,8" FontSize="13"
                                                         Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                                         BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                         Height="100"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top"
                                                         Margin="0,0,0,10" />

                                                <TextBlock Text="记忆线索" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                                <ui:TextBox Text="{Binding EditMemoryHook, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="36" Padding="10,6" FontSize="13"
                                                         Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                                                         BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                                         VerticalContentAlignment="Center" Margin="0,0,0,14" />
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Bottom Action Buttons -->
                                    <Border Grid.Row="1"
                                            Visibility="{Binding IsReviewMode, Converter={StaticResource InverseBoolToVis}}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0"
                                            Margin="0,8,0,0">
                                        <StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                        <Grid>
                                            <!-- Normal Mode Actions -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <ui:Button Content="复制" Command="{Binding CopyWordCommand}" Style="{StaticResource QuietActionButton}" ToolTip="复制单词与释义" Margin="0,0,8,0" />
                                                <ui:Button Content="编辑" Style="{StaticResource SecondaryActionButton}" ToolTip="编辑词条（F2）"
                                                        Command="{Binding StartEditCommand}"
                                                        Padding="14,6"
                                                        Margin="0,0,8,0"
                                                        Background="{StaticResource SubtleSurfaceBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                                <ui:Button Content="更多 ···" Click="OpenActionMenu_Click" Style="{StaticResource QuietActionButton}" ToolTip="更多词条操作" AutomationProperties.Name="更多词条操作">
                                                    <ui:Button.ContextMenu>
                                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <MenuItem Header="删除词条" Command="{Binding DeleteWordCommand}" ToolTip="删除后可撤销；Anki 中的卡片会保留">
                                                                <MenuItem.Style>
                                                                    <Style TargetType="MenuItem">
                                                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                                                                            <Border x:Name="MenuSurface" Background="#FFFEFB" Padding="14,8" CornerRadius="4"><TextBlock Text="{TemplateBinding Header}" Foreground="#A43739" FontSize="13" /></Border>
                                                                            <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuSurface" Property="Background" Value="#FAEEEE" /></Trigger></ControlTemplate.Triggers>
                                                                        </ControlTemplate></Setter.Value></Setter>
                                                                    </Style>
                                                                </MenuItem.Style>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </ui:Button.ContextMenu>
                                                </ui:Button>
                                            </StackPanel>

                                            <TextBlock Text="Ctrl+S 保存" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                            <!-- Edit Mode Actions -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <ui:Button Content="保存修改" Style="{StaticResource PrimaryActionButton}" ToolTip="保存修改（Ctrl+S）"
                                                        Command="{Binding SaveEditCommand}" IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBool}}"
                                                        Padding="14,6"
                                                        Background="{StaticResource AccentBrush}"
                                                        Foreground="{StaticResource OnAccentBrush}"
                                                        BorderThickness="0"
                                                        Margin="0,0,8,0"
                                                        Cursor="Hand" />
                                                <ui:Button Content="取消" Style="{StaticResource SecondaryActionButton}" ToolTip="放弃本次编辑（Esc）"
                                                        Command="{Binding CancelEditCommand}"
                                                        Padding="14,6"
                                                        Background="{StaticResource SubtleSurfaceBrush}"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        BorderThickness="0"
                                                        Cursor="Hand" />
                                            </StackPanel>
                                        </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        </Grid>

                        <Border x:Name="EmptyLibraryWorkspace"
                                Background="{StaticResource SurfaceBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Words.Count}" Value="0" />
                                                <Condition Binding="{Binding SourceFilter}" Value="" /><Condition Binding="{Binding SearchQuery}" Value="" /><Condition Binding="{Binding SelectedFilterIndex}" Value="0" /><Condition Binding="{Binding CanUndoDelete}" Value="False" />
                                                <Condition Binding="{Binding IsLoading}" Value="False" /><Condition Binding="{Binding HasLoadError}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                                       Width="52"
                                       Height="52" />
                                <TextBlock Text="还没有收藏的词条"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0" />
                                <TextBlock Text="先查一个词并收藏；阅读时也可以选中文字后取词。"
                                           FontSize="{StaticResource CaptionFontSize}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0" /><ui:Button Content="去查词" Tag="Lookup" Click="NavigationItem_Click" HorizontalAlignment="Center" Margin="0,16,0,0" Style="{StaticResource PrimaryActionButton}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= TAB 2: 查单词 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="LookupTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="查词" />
                    </StackPanel>
                </TabItem.Header>
                <views:WordLookupView x:Name="LookupPage" />
            </TabItem>

            <!-- ================= TAB 3: 待同步 ================= -->
            <TabItem Style="{StaticResource TabItemStyle}" x:Name="SyncTab">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,11,0" />
                        <TextBlock Text="同步状态" />
                    </StackPanel>
                </TabItem.Header>
                <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="同步状态" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="查看词库同步结果，重试失败任务或处理冲突"
                                       Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryActionButton}" VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                ToolTip="刷新同步状态" AutomationProperties.Name="刷新同步状态">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,8">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Border x:Name="WebDavSyncCard" Background="Transparent" Padding="0,8,0,24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,24">
                                <StackPanel>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="词库同步" FontSize="16" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding WebDavTitle}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding WebDavDescription}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding WebDavLastSuccess}" Visibility="{Binding WebDavLastSuccess, Converter={StaticResource StringToVis}}" FontSize="12" Margin="0,6,0,0" />
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsWebDavBusy, Converter={StaticResource BoolToVis}}" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <ui:Button Content="立即同步" Visibility="{Binding IsWebDavEnabled, Converter={StaticResource BoolToVis}}" Command="{Binding RetryWebDavCommand}" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0" />
                                        <ui:Button Content="设置" ToolTip="WebDAV 词库同步设置" Click="OpenWebDavSettings_Click" Style="{StaticResource QuietActionButton}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding WebDavActionMessage}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding WebDavActionMessage, Converter={StaticResource StringToVis}}" />
                                    <Expander Header="错误详情" Margin="0,8,0,0" Visibility="{Binding WebDavError, Converter={StaticResource StringToVis}}">
                                        <TextBox Text="{Binding WebDavError, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" />
                                    </Expander>
                                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasWebDavConflict, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="对比两端内容，选择要保留的版本。选择会覆盖这条语境及词条信息，也会采用该版本的删除状态。多个冲突需逐条处理。" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding ConflictRecordId, StringFormat=记录：{0}}" FontSize="11" Margin="0,4,0,8" TextWrapping="Wrap" />
