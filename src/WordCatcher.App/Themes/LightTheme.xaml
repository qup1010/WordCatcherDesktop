<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/presentation/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Fluent 2 Mica / Layer / Card surfaces (Light) -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F5F6" po:Freeze="True" />
    <SolidColorBrush x:Key="CanvasLayerBrush" Color="#F9FAFA" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#EFF2F4" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EB" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#DDE1E6" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CFD5DC" po:Freeze="True" />

    <!-- Text hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D1F" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#596068" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A828C" po:Freeze="True" />

    <!-- Brand Teal accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0F766E" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0D665F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0A544E" po:Freeze="True" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E6F3F0" po:Freeze="True" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0F766E" po:Freeze="True" />

    <!-- Interactive states -->
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#EAEFF1" po:Freeze="True" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#F1F4F5" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#E4F2F0" po:Freeze="True" />

    <!-- Semantic states -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FEF2F2" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerHoverSurfaceBrush" Color="#FDE8E8" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#F5C2C0" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF9EC" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#ECC88D" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#6F5125" po:Freeze="True" />

    <!-- Editorial reading hook accent -->
    <SolidColorBrush x:Key="AmberHookSurfaceBrush" Color="#FAF3E4" po:Freeze="True" />
    <SolidColorBrush x:Key="AmberHookBorderBrush" Color="#B45309" po:Freeze="True" />
    <SolidColorBrush x:Key="AmberHookLabelBrush" Color="#92400E" po:Freeze="True" />
    <SolidColorBrush x:Key="AmberHookTextBrush" Color="#5E564B" po:Freeze="True" />

    <!-- Window chrome & notifications -->
    <SolidColorBrush x:Key="TitleBarGlassBrush" Color="#01FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F21A1D1F" po:Freeze="True" />
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="#FFFFFF" po:Freeze="True" />

    <!-- WPF-UI Fluent token synchronization -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#0F766E" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#0F766E" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#0D665F" po:Freeze="True" />
    <Color x:Key="SystemAccentColorPrimary">#0F766E</Color>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#0F766E" po:Freeze="True" />

    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="#F6F7F8" po:Freeze="True" />
    <SolidColorBrush x:Key="CardForeground" Color="#1A1D1F" po:Freeze="True" />
    <SolidColorBrush x:Key="CardForegroundDisabled" Color="#9CA3AF" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E7EB" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBorderBrushDisabled" Color="#ECEEF0" po:Freeze="True" />
    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#E4E7EB" po:Freeze="True" />
    <SolidColorBrush x:Key="InfoBarInformationalIconBrush" Color="#005FB8" po:Freeze="True" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F766E" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0D665F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0A544E" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6F3F0" po:Freeze="True" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0F766E" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0D665F" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0A544E" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#0D665F" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#0A544E" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF" po:Freeze="True" />
</ResourceDictionary>
