<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/presentation/2006/xaml/presentation/options"
                    mc:Ignorable="po">
    <!-- Fluent 2 Mica / Layer / Card surfaces (Dark) -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#1B1D1F" po:Freeze="True" />
    <SolidColorBrush x:Key="CanvasLayerBrush" Color="#222528" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2E31" po:Freeze="True" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#32363B" po:Freeze="True" />
    <SolidColorBrush x:Key="BorderBrush" Color="#383C42" po:Freeze="True" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#33373D" po:Freeze="True" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#474C53" po:Freeze="True" />

    <!-- Text hierarchy -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAB2BA" po:Freeze="True" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7D858E" po:Freeze="True" />

    <!-- Brand Teal accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#26BFAF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1DA899" po:Freeze="True" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#07231F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#153733" po:Freeze="True" />
    <SolidColorBrush x:Key="FocusBrush" Color="#5EEAD4" po:Freeze="True" />

    <!-- Interactive states -->
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="#34383D" po:Freeze="True" />
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#2F3338" po:Freeze="True" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="#193C38" po:Freeze="True" />

    <!-- Semantic states -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#3A1D20" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerHoverSurfaceBrush" Color="#472427" po:Freeze="True" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#6F3035" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FCE100" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#332919" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#6E5220" po:Freeze="True" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E6CFA3" po:Freeze="True" />

    <!-- Editorial reading hook accent -->
    <SolidColorBrush x:Key="AmberHookSurfaceBrush" Color="#2B2316" po:Freeze="True" />
    <SolidColorBrush x:Key="AmberHookBorderBrush" Color="#D97706" po:Freeze="True" />
    <SolidColorBrush x:Key="AmberHookLabelBrush" Color="#FBBF24" po:Freeze="True" />
    <SolidColorBrush x:Key="AmberHookTextBrush" Color="#DECBAE" po:Freeze="True" />

    <!-- Window chrome & notifications -->
    <SolidColorBrush x:Key="TitleBarGlassBrush" Color="#01000000" po:Freeze="True" />
    <SolidColorBrush x:Key="ToastSurfaceBrush" Color="#F2F3F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="ToastForegroundBrush" Color="#1A1D1F" po:Freeze="True" />

    <!-- WPF-UI Fluent token synchronization -->
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#26BFAF" po:Freeze="True" />
    <Color x:Key="SystemAccentColorPrimary">#2DD4BF</Color>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2DD4BF" po:Freeze="True" />

    <SolidColorBrush x:Key="CardBackground" Color="#2B2E31" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBackgroundDisabled" Color="#25282B" po:Freeze="True" />
    <SolidColorBrush x:Key="CardForeground" Color="#F3F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="CardForegroundDisabled" Color="#6E7680" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383C42" po:Freeze="True" />
    <SolidColorBrush x:Key="CardBorderBrushDisabled" Color="#303439" po:Freeze="True" />
    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#383C42" po:Freeze="True" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="#2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#26BFAF" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#1DA899" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#07231F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#07231F" po:Freeze="True" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#051B18" po:Freeze="True" />

    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#2DD4BF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#26BFAF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#1DA899" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#26BFAF" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#1DA899" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#07231F" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#07231F" po:Freeze="True" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#07231F" po:Freeze="True" />
</ResourceDictionary>
