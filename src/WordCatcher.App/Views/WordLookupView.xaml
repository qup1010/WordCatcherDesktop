<UserControl x:Class="WordCatcher.App.Views.WordLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
             xmlns:converters="clr-namespace:WordCatcher.App.Converters"
             xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WordLookupViewModel}"
             FontFamily="Segoe UI, Microsoft YaHei UI, sans-serif"
             Background="{DynamicResource CanvasBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="View_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/WordCatcher.App;component/Themes/DesignSystem.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="LookupActionButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryActionButton}" />

        <Style x:Key="LookupIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource LookupActionButton}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="查词" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="输入单词、短语或句子，查看释义与翻译。"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <Border Style="{StaticResource SurfaceCardStyle}"
                    BorderBrush="{StaticResource ControlBorderBrush}"
                    CornerRadius="8"
                    Padding="11,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="17"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="1,0,9,0" />
                    <ui:TextBox x:Name="QueryBox"
                             Grid.Column="1"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="输入单词、短语或句子" AutomationProperties.Name="查词内容"
                             ClearButtonEnabled="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,6"
                             FontSize="15"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             MinHeight="36"
                             ToolTip="Enter 查询 · Esc 清空 · Ctrl+F 聚焦"
                             KeyDown="QueryBox_KeyDown" />
                    <ui:Button Grid.Column="2"
                            Command="{Binding ClearQueryCommand}"
                            Style="{StaticResource LookupIconButton}"
                            Background="Transparent"
                            Foreground="{StaticResource TextMutedBrush}"
                            ToolTip="清空（Esc）" AutomationProperties.Name="清空查词内容"
                            Visibility="{Binding Query, Converter={StaticResource StringToVis}}">
                        <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons" FontSize="13" />
                    </ui:Button>
                    <ui:Button Grid.Column="3"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding Lookup.IsLoading, Converter={StaticResource InverseBool}}"

                            Style="{StaticResource PrimaryActionButton}"
                            Margin="8,0,0,0"
                            ToolTip="查询（Enter）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="查询" Margin="6,0,0,0" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
            <TextBlock Text="{Binding QueryError}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="{StaticResource CaptionFontSize}"
                       Margin="3,7,0,0"
                       Visibility="{Binding QueryError, Converter={StaticResource StringToVis}}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <StackPanel x:Name="LookupEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVis}}">
                <Border Width="68" Height="68" Background="{StaticResource AccentSubtleBrush}" CornerRadius="16" HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/WordCatcher.App;component/Assets/WordCatcher.png"
                           Width="43" Height="43" Stretch="Uniform" />
                </Border>
                <TextBlock Text="从一个单词开始"
                           FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="离线词典优先；短语和句子也可以查询。"
                           FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Lookup.IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar Width="230" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource AccentSubtleBrush}" />
                <TextBlock Text="{Binding Lookup.StatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel Visibility="{Binding Lookup.HasError, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource DangerSurfaceBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="暂时无法完成查询" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding Lookup.ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="{StaticResource CaptionFontSize}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <ui:Button Content="重新查询" Command="{Binding SearchCommand}" Style="{StaticResource LookupActionButton}"
                                HorizontalAlignment="Left" Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer x:Name="LookupResultScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Lookup.HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,5,0">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                        <Grid DataContext="{Binding Lookup}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2">
                                    <TextBlock TextWrapping="Wrap" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding Word}" /><Style.Triggers><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Text" Value="句子翻译" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Reading}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Visibility="{Binding Reading, Converter={StaticResource StringToVis}}" />
                                        <TextBlock Text="{Binding PartOfSpeech}" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource AccentBrush}"
                                                   Margin="12,0,0,0" Visibility="{Binding PartOfSpeech, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                    <ui:Button Command="{Binding SpeakCommand}" Style="{StaticResource LookupIconButton}"
                                            ToolTip="朗读当前单词" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Command="{Binding CopyResultCommand}" Style="{StaticResource LookupIconButton}"
                                            ToolTip="复制单词和释义" Margin="0,0,6,0">
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="{StaticResource BodyFontSize}" />
                                    </ui:Button>
                                    <ui:Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                                            Style="{StaticResource PrimaryActionButton}"
                                            ToolTip="保存到生词库">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SaveButtonText}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ForceAiCommand}"
                                            Background="{StaticResource SubtleSurfaceBrush}"
                                            Foreground="{StaticResource AccentBrush}"
                                            Margin="6,0,0,0"
                                            ToolTip="结合语境重新解释当前单词">
                                        <ui:Button.Style>
                                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource LookupActionButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="{x:Static enums:LookupSource.Ai}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="AI 详解" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </ui:Button>
                                </WrapPanel>
                            </Grid>

                            <Grid x:Name="ResultColumns" Grid.Row="1" SizeChanged="ResultColumns_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition x:Name="SecondaryColumn" Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="DefinitionPanel" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding SelectedText}" Visibility="{Binding IsLongText, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" /><TextBlock FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="核心释义" /><Style.Triggers><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Text" Value="译文" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <TextBlock Text="{Binding Definition}" FontSize="15" LineHeight="25" Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource InverseBoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding DisplayPosGroups}" Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Background="{StaticResource AccentSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2" VerticalAlignment="Top" Margin="0,1,8,0">
                                                        <TextBlock Text="{Binding DisplayPos, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" FontStyle="Italic" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding QuickSummary}" FontSize="{StaticResource BodyFontSize}" LineHeight="23" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            <StackPanel Margin="0,18,0,0">
                                <ui:Button Content="{Binding DetailsToggleText}" Command="{Binding ToggleDetailsCommand}"
                                        Style="{StaticResource LookupActionButton}" HorizontalContentAlignment="Left"
                                        Background="{StaticResource SubtleSurfaceBrush}" Foreground="{StaticResource TextSecondaryBrush}" Padding="11,8"
                                        Visibility="{Binding CanExpandDetails, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding DisplayPosGroups}" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,13,0,2">
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" Margin="0,0,0,8" TextWrapping="Wrap"><Run Text="{Binding DisplayPos, Mode=OneWay}" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding Summary}" /></TextBlock>
                                                <ItemsControl ItemsSource="{Binding Meanings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <StackPanel>
                                                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayHeading}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" FontSize="{StaticResource CaptionFontSize}" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0" /></Grid>
                                                                    </StackPanel>
                                                                    <StackPanel Margin="4,10,4,2">
                                                                        <TextBlock Text="{Binding DetailExplanation}" FontSize="13" LineHeight="21" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Visibility="{Binding DetailExplanation, Converter={StaticResource StringToVis}}" />
                                                                        <ItemsControl ItemsSource="{Binding FirstExamples}" Margin="0,7,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0" Padding="9,2" Margin="0,0,0,8">
                                                                                        <StackPanel>
                                                                                        <TextBlock Text="{Binding Text}" FontSize="{StaticResource CaptionFontSize}" LineHeight="19" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Translation}" FontSize="{StaticResource CaptionFontSize}" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
<Expander Header="{Binding AdditionalExamplesLabel}" Visibility="{Binding HasAdditionalExamples, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6"><ItemsControl ItemsSource="{Binding AdditionalExamples}" Margin="0,7,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0" Padding="9,2" Margin="0,0,0,8">
                                                                                        <StackPanel>
                                                                                        <TextBlock Text="{Binding Text}" FontSize="{StaticResource CaptionFontSize}" LineHeight="19" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                                        <TextBlock Text="{Binding Translation}" FontSize="{StaticResource CaptionFontSize}" LineHeight="19" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl></Expander>
                                                                        <StackPanel TextElement.FontSize="{StaticResource CaptionFontSize}" TextElement.Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding UsageNote, Converter={StaticResource StringToVis}}"><TextBlock Text="用法提示" FontSize="{StaticResource CaptionFontSize}" Margin="0,8,0,0" />
                                                                            <TextBlock Text="{Binding UsageNote}" FontSize="{StaticResource CaptionFontSize}" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ContextPanel" Grid.Column="1" IsVisibleChanged="ContextPanel_IsVisibleChanged" Visibility="{Binding HasSecondaryContent, Converter={StaticResource BoolToVis}}">
<TextBlock Text="{Binding OriginalSentence}" TextWrapping="Wrap" FontSize="13" LineHeight="21" Margin="0,0,0,12" Visibility="{Binding OriginalSentence, Converter={StaticResource StringToVis}}" />
                                    <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="12,10"
                                            Visibility="{Binding ContextTranslation, Converter={StaticResource StringToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="语境翻译" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ContextTranslation}" FontSize="13" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2,0,0,0" CornerRadius="0,8,8,0"
                                            Padding="12,10" Margin="0,10,0,0" Visibility="{Binding MemoryHook, Converter={StaticResource StringToVis}}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="记忆线索" FontSize="{StaticResource CaptionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <ToggleButton IsChecked="{Binding IsMemoryHookExpanded}" HorizontalAlignment="Right"
                                                              Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                              FontSize="{StaticResource CaptionFontSize}" Cursor="Hand" Padding="4,0">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"><Setter Property="Text" Value="展开" /><Style.Triggers><DataTrigger Binding="{Binding IsMemoryHookExpanded}" Value="True"><Setter Property="Text" Value="收起" /></DataTrigger></Style.Triggers></Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToggleButton>
                                            </Grid>
                                            <TextBlock Text="{Binding MemoryHook}" FontSize="{StaticResource CaptionFontSize}" LineHeight="20" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock"><Setter Property="MaxHeight" Value="60" /><Style.Triggers><DataTrigger Binding="{Binding IsMemoryHookExpanded}" Value="True"><Setter Property="MaxHeight" Value="Infinity" /></DataTrigger></Style.Triggers></Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>


                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Lookup.SavedStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}"
                               TextWrapping="Wrap" Margin="3,9,0,0"
                               Visibility="{Binding Lookup.SavedStatusText, Converter={StaticResource StringToVis}}" />
<TextBlock Text="{Binding Lookup.SyncStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" Margin="3,4,0,0" Visibility="{Binding Lookup.SyncStatusText, Converter={StaticResource StringToVis}}" />
<TextBlock Text="{Binding Lookup.ActionStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" Margin="3,4,0,0" Visibility="{Binding Lookup.ActionStatusText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
