<UserControl x:Class="WordCatcher.App.Views.WordLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:WordCatcher.App.Controls"
             xmlns:vm="clr-namespace:WordCatcher.App.ViewModels"
             xmlns:converters="clr-namespace:WordCatcher.App.Converters"
             xmlns:enums="clr-namespace:WordCatcher.Core.Enums;assembly=WordCatcher.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WordLookupViewModel}"
             FontFamily="{DynamicResource UiFontFamily}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             Loaded="View_Loaded">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/WordCatcher.App;component/Themes/DesignSystem.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />

        <Style x:Key="LookupActionButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SecondaryActionButton}" />

        <Style x:Key="LookupIconButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource LookupActionButton}">
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasLayerBrush}" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="查词" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="输入单词或句子，查看释义和翻译"
                           Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <Border
                    CornerRadius="8"
                    Padding="11,6">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource SurfaceCardStyle}">
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CrispSymbolIcon Symbol="Search20" FontSize="17" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="QueryBox"
                             Style="{StaticResource LookupQueryTextBox}"
                             Grid.Column="1"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             Tag="输入单词、短语或句子" AutomationProperties.Name="查词内容"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="10,6"
                             FontSize="15"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             VerticalContentAlignment="Center"
                             MinHeight="36"
                             ToolTip="Enter 查询 · Esc 清空 · Ctrl+F 聚焦"
                             KeyDown="QueryBox_KeyDown" />
                    <ui:Button Grid.Column="2"
                            Command="{Binding ClearQueryCommand}"
                            Style="{StaticResource LookupIconButton}"
                            Background="Transparent"
                            Foreground="{DynamicResource TextMutedBrush}"
                            ToolTip="清空（Esc）" AutomationProperties.Name="清空查词内容"
                            Visibility="{Binding Query, Converter={StaticResource StringToVis}}">
                        <controls:CrispSymbolIcon Symbol="Dismiss16" FontSize="14" />
                    </ui:Button>
                    <ui:Button Grid.Column="3"
                            Command="{Binding SearchCommand}"
                            IsEnabled="{Binding Lookup.IsLoading, Converter={StaticResource InverseBool}}"
                            Style="{StaticResource PrimaryActionButton}"
                            MinHeight="36" Padding="14,6"
                            Margin="8,0,0,0"
                            ToolTip="查询（Enter）">
                        <TextBlock Text="查询" />
                    </ui:Button>
                </Grid>
            </Border>
            <TextBlock Text="{Binding QueryError}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="{StaticResource CaptionFontSize}"
                       Margin="3,7,0,0"
                       Visibility="{Binding QueryError, Converter={StaticResource StringToVis}}" />
            <Expander x:Name="LookupHistoryExpander" Header="查询历史" Margin="0,10,0,0" MaxHeight="180">
                <Expander.Style><Style TargetType="Expander"><Style.Triggers>
                    <DataTrigger Binding="{Binding Lookup.History.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></Expander.Style>
                <Expander.Template>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalAlignment="Left" Style="{StaticResource QuietDisclosureToggle}" />
                            <ui:Button Grid.Column="1" Content="刷新历史" Command="{Binding LoadHistoryCommand}" Style="{StaticResource QuietActionButton}" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <ContentPresenter Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0" />
                        </StackPanel>
                    </ControlTemplate>
                </Expander.Template>
                <StackPanel>
                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Lookup.History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource QuietActionButton}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,1">
                                        <StackPanel><TextBlock Text="{Binding Capture.SelectedText}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Result.Definition}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Expander>
        </StackPanel>

        <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel x:Name="LookupEmptyState" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,20,0,0"
                        Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="输入或粘贴词句，按 Enter 查询" TextWrapping="Wrap"
                           FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Lookup.IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar Width="230" Height="4" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSubtleBrush}" />
                <TextBlock Text="{Binding Lookup.StatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel x:Name="LookupErrorPanel" Visibility="{Binding Lookup.HasError, Converter={StaticResource BoolToVis}}">
                <Border Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="查询未完成" FontWeight="Medium" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{Binding Lookup.ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource CaptionFontSize}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button Content="重新查询" Command="{Binding Lookup.RetryCommand}" Style="{StaticResource LookupActionButton}"
                                       HorizontalAlignment="Left" Margin="0,0,8,0" />
                            <ui:Button Content="改用 AI 详解" Command="{Binding Lookup.ForceAiCommand}"
                                       Visibility="{Binding Lookup.CanUseAiFallback, Converter={StaticResource BoolToVis}}"
                                       Style="{StaticResource LookupActionButton}" HorizontalAlignment="Left"
                                       Background="{DynamicResource AccentSubtleBrush}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                            <ui:Button Content="改用在线快译" Command="{Binding Lookup.QuickFallbackCommand}"
                                       Visibility="{Binding Lookup.CanUseQuickFallback, Converter={StaticResource BoolToVis}}"
                                       Style="{StaticResource LookupActionButton}" HorizontalAlignment="Left" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" x:Name="LookupResultScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding Lookup.HasResult, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,5,0">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="20">
                        <Grid DataContext="{Binding Lookup}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.ColumnSpan="2">
                                    <TextBlock TextWrapping="Wrap" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource HeadwordFontFamily}" /><Setter Property="Text" Value="{Binding Word}" /><Style.Triggers><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Text" Value="句子翻译" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox Text="{Binding Reading, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontFamily="{StaticResource PhoneticFontFamily}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Visibility="{Binding Reading, Converter={StaticResource StringToVis}}" />
                                        <TextBlock Text="{Binding PartOfSpeech}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource AccentBrush}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding PartOfSpeech, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                    <ui:Button Command="{Binding SpeakCommand}" Style="{StaticResource LookupIconButton}"
                                            ToolTip="朗读" AutomationProperties.Name="朗读词条" Margin="0,0,6,0">
                                        <controls:CrispSymbolIcon Symbol="Speaker220" FontSize="16" />
                                    </ui:Button>
                                    <ui:Button Command="{Binding CopyResultCommand}" Style="{StaticResource LookupIconButton}"
                                            ToolTip="复制单词与释义" AutomationProperties.Name="复制词条" Margin="0,0,6,0">
                                        <controls:CrispSymbolIcon Symbol="Copy20" FontSize="15" />
                                    </ui:Button>
                                    <ui:Button Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                                            Style="{StaticResource PrimaryActionButton}"
                                            ToolTip="存入生词库">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:CrispSymbolIcon Symbol="Bookmark20" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SaveButtonText}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Command="{Binding ForceAiCommand}" IsEnabled="{Binding CanSave}"
                                            Style="{StaticResource LookupActionButton}"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            Foreground="{DynamicResource AccentBrush}"
                                            Margin="6,0,0,0"
                                            ToolTip="使用 AI 结合语境生成详解">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:CrispSymbolIcon Symbol="Sparkle20" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AiButtonText}" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </ui:Button>
                                </WrapPanel>
                            </Grid>

                            <Grid x:Name="ResultColumns" Grid.Row="1" SizeChanged="ResultColumns_SizeChanged">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" />
                                    <ColumnDefinition x:Name="SecondaryColumn" Width="0.85*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="DefinitionPanel" Margin="0,0,24,0">
                                    <TextBox Text="{Binding SelectedText, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Visibility="{Binding IsLongText, Converter={StaticResource BoolToVis}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />
                                    <TextBlock FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,9"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="核心释义" /><Style.Triggers><DataTrigger Binding="{Binding IsLongText}" Value="True"><Setter Property="Text" Value="译文" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <TextBlock Text="{Binding LearningExpression}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10" Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVis}}" />
                                    <TextBox Text="{Binding Definition, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"
                                             Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource InverseBoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding DisplayPosGroups}" Visibility="{Binding HasStructuredDefinitions, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Border Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Top" Margin="0,1,8,0">
                                                        <TextBlock Text="{Binding DisplayPos, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" FontStyle="Italic" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBox Grid.Column="1" Text="{Binding QuickSummary, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource BodyFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                            <StackPanel Margin="0,18,0,0">
                                <ui:Button Content="{Binding DetailsToggleText}" Command="{Binding ToggleDetailsCommand}"
                                        Style="{StaticResource LookupActionButton}" HorizontalContentAlignment="Left"
                                        Padding="12,7"
                                        Visibility="{Binding CanExpandDetails, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding DisplayPosGroups}" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,13,0,2">
                                                <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" Margin="0,0,0,8" TextWrapping="Wrap"><Run Text="{Binding DisplayPos, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /><Run Text="  " /><Run Text="{Binding Summary}" /></TextBlock>
                                                <ItemsControl ItemsSource="{Binding Meanings}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                                <StackPanel>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <TextBox Text="{Binding DisplayHeading, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding PriorityLabel}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" Margin="8,1,0,0" />
                                                                    </Grid>
                                                                    <StackPanel Margin="0,8,0,0">
                                                                        <TextBox Text="{Binding DetailExplanation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="{Binding DetailExplanation, Converter={StaticResource StringToVis}}" />
                                                                        <ItemsControl ItemsSource="{Binding FirstExamples}" Margin="0,7,0,0">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2,0,0,0" Padding="9,2" Margin="0,0,0,6">
                                                                                        <StackPanel>
                                                                                            <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                            <TextBox Text="{Binding Translation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <Expander Header="{Binding AdditionalExamplesLabel}" Visibility="{Binding HasAdditionalExamples, Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
                                                                            <ItemsControl ItemsSource="{Binding AdditionalExamples}" Margin="0,7,0,0">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2,0,0,0" Padding="9,2" Margin="0,0,0,6">
                                                                                            <StackPanel>
                                                                                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                                <TextBox Text="{Binding Translation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding Translation, Converter={StaticResource StringToVis}}" />
                                                                                            </StackPanel>
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </Expander>
                                                                        <StackPanel TextElement.FontSize="{StaticResource CaptionFontSize}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding UsageNote, Converter={StaticResource StringToVis}}">
                                                                            <TextBlock Text="用法提示" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,2" />
                                                                            <TextBox Text="{Binding UsageNote, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ContextPanel" Grid.Column="1" IsVisibleChanged="ContextPanel_IsVisibleChanged" Visibility="{Binding HasSecondaryContent, Converter={StaticResource BoolToVis}}">
                                    <Expander Header="解析与例句" Visibility="{Binding HasLearningDetails, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel Visibility="{Binding Analysis.KeyExplanation, Converter={StaticResource StringToVis}}" Margin="0,0,0,8">
                                                <TextBlock Text="语境解析" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding Analysis.KeyExplanation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding Analysis.UsageNote, Converter={StaticResource StringToVis}}" Margin="0,0,0,8">
                                                <TextBlock Text="用法提示" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding Analysis.UsageNote, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding Analysis.Example, Converter={StaticResource StringToVis}}">
                                                <TextBlock Text="拓展例句" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,2" />
                                                <TextBox Text="{Binding Analysis.Example, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBox Text="{Binding Analysis.ExampleTranslation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="{Binding Analysis.ExampleTranslation, Converter={StaticResource StringToVis}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>
                                    <Expander Header="编辑与笔记" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="释义" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ui:TextBox Text="{Binding EditDefinition, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                            <TextBlock Text="原句翻译" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ui:TextBox Text="{Binding EditTranslation, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8" />
                                            <TextBlock Text="个人笔记" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <ui:TextBox Text="{Binding LearningNote, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Expander>
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding OriginalSentence, Converter={StaticResource StringToVis}}">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="原句" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <WrapPanel HorizontalAlignment="Right">
                                                <ui:Button Content="{Binding TranslateSentenceButtonText}"
                                                           Command="{Binding TranslateSentenceCommand}"
                                                           Visibility="{Binding CanTranslateSentence, Converter={StaticResource BoolToVis}}"
                                                           IsEnabled="{Binding IsTranslatingSentence, Converter={StaticResource InverseBool}}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Padding="6,2" MinHeight="24" FontSize="{StaticResource CaptionFontSize}" />
                                                <ui:Button Content="改用 AI" Command="{Binding UseAiSentenceTranslationCommand}"
                                                           Visibility="{Binding CanUseAiSentenceTranslation, Converter={StaticResource BoolToVis}}"
                                                           IsEnabled="{Binding IsTranslatingSentence, Converter={StaticResource InverseBool}}"
                                                           Style="{StaticResource QuietActionButton}"
                                                           Padding="6,2" MinHeight="24" Margin="4,0,0,0" FontSize="{StaticResource CaptionFontSize}" />
                                            </WrapPanel>
                                        </Grid>
                                        <TextBox Text="{Binding OriginalSentence, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding CaptureSourceSummary, StringFormat=来源：{0}}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding CaptureSourceSummary, Converter={StaticResource StringToVis}}" />
                                        <TextBlock Text="{Binding SentenceTranslationError}" Foreground="{DynamicResource DangerBrush}" FontSize="{StaticResource CaptionFontSize}"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"
                                                   Visibility="{Binding SentenceTranslationError, Converter={StaticResource StringToVis}}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource ReadingTonalBoxStyle}" Padding="12,10"
                                            Visibility="{Binding ContextTranslation, Converter={StaticResource StringToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="语境翻译" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBox Text="{Binding ContextTranslation, Mode=OneWay}" Style="{StaticResource SelectableTextBlockBox}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MemoryHookCardStyle}"
                                            Padding="12,10" Margin="0,10,0,0" Visibility="{Binding MemoryHook, Converter={StaticResource StringToVis}}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="记忆线索" FontSize="{StaticResource CaptionFontSize}" FontWeight="Medium" Foreground="{DynamicResource AmberHookLabelBrush}" VerticalAlignment="Center" />
                                                <ToggleButton IsChecked="{Binding IsMemoryHookExpanded}" Style="{StaticResource CompactPillToggleStyle}" HorizontalAlignment="Right"
                                                              Foreground="{DynamicResource AmberHookLabelBrush}"
                                                              FontSize="{StaticResource CaptionFontSize}">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"><Setter Property="Text" Value="展开" /><Style.Triggers><DataTrigger Binding="{Binding IsMemoryHookExpanded}" Value="True"><Setter Property="Text" Value="收起" /></DataTrigger></Style.Triggers></Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </ToggleButton>
                                            </Grid>
                                            <TextBox Text="{Binding MemoryHook, Mode=OneWay}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource AmberHookTextBrush}" Margin="0,5,0,0">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource SelectableTextBlockBox}">
                                                        <Setter Property="MaxHeight" Value="60" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMemoryHookExpanded}" Value="True">
                                                                <Setter Property="MaxHeight" Value="Infinity" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="{Binding Lookup.SavedStatusText, Converter={StaticResource StringToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Lookup.SavedStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ui:Button Grid.Column="1" Content="撤销" Command="{Binding Lookup.UndoSaveCommand}" Visibility="{Binding Lookup.CanUndoSave, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding Lookup.IsUndoingSave, Converter={StaticResource InverseBool}}" Style="{StaticResource LookupActionButton}" Padding="6,2" MinHeight="24" MinWidth="0" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0" ToolTip="撤销本次本地收藏" AutomationProperties.Name="撤销本地收藏" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Lookup.SyncStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource CaptionFontSize}" TextWrapping="Wrap" Margin="3,4,0,0" Visibility="{Binding Lookup.SyncStatusText, Converter={StaticResource StringToVis}}" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,12"
                    Padding="14,7"
                    CornerRadius="16"
                    Background="{DynamicResource ToastSurfaceBrush}"
                    IsHitTestVisible="False"
                    Visibility="{Binding Lookup.ActionStatusText, Converter={StaticResource StringToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.2" ShadowDepth="2" Color="#000000" />
                </Border.Effect>
                <TextBlock Text="{Binding Lookup.ActionStatusText}" FontSize="{StaticResource CaptionFontSize}" Foreground="{DynamicResource ToastForegroundBrush}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
